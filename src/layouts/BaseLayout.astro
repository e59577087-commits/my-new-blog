---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ScrollTopButton from "../components/ScrollTopButton.astro";
import CardTilt from "../components/CardTilt.astro";
import OmikujiDraw from "../components/OmikujiDraw.astro";
import ArticlePageTransition from "../components/ArticlePageTransition.astro";
import SitePet from "../components/SitePet.astro";
import { site } from "../data/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
};

const { title, description = site.description, image = site.socialPreview, type = "website", publishedTime } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const socialImageUrl = new URL(image, site.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#f5f7fb" />
    <script is:inline>
      (() => {
        const storageKey = "blog-theme";
        const root = document.documentElement;
        const themeMeta = () => document.querySelector('meta[name="theme-color"]');
        const getSystemTheme = () => (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const getStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey);
            return value === "dark" || value === "light" ? value : null;
          } catch {
            return null;
          }
        };
        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          root.classList.toggle("dark", theme === "dark");
          root.classList.toggle("light", theme === "light");
          root.style.colorScheme = theme;
          themeMeta()?.setAttribute("content", theme === "dark" ? "#12161d" : "#f5f7fb");
        };

        applyTheme(getStoredTheme() ?? getSystemTheme());
      })();
    </script>
    <script is:inline>
      (() => {
        const storageKey = "blog-article-transition-v1";
        try {
          const raw = window.sessionStorage.getItem(storageKey);
          if (!raw) return;

          const payload = JSON.parse(raw);
          const isFresh = typeof payload?.createdAt === "number" && Date.now() - payload.createdAt < 8000;
          if (isFresh && payload.pathname === window.location.pathname) {
            document.documentElement.dataset.articleTransition = "active";
          }
          window.sessionStorage.removeItem(storageKey);
        } catch {
          try {
            window.sessionStorage.removeItem(storageKey);
          } catch {}
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const storageKey = "blog-appearance-settings-v1";
        const sitePetIds = ["ikun", "yukino-swimsuit", "xilian"];
        const wallpaperIds = ["summer", "salvation"];
        const defaults = {
          hue: 150,
          accentMode: "color",
          wallpaperMode: "banner",
          wallpaperId: "summer",
          bannerTitle: true,
          particles: true,
          homeBlackHole: true,
          particleHue: 42,
          articleLayout: "list",
          sitePetEnabled: true,
          sitePetId: "ikun",
        };
        const isObject = (value) => value && typeof value === "object" && !Array.isArray(value);
        const normalizeBoolean = (value, fallback) => {
          if (typeof value === "boolean") return value;
          if (value === "true") return true;
          if (value === "false") return false;
          return fallback;
        };
        const normalize = (settings) => {
          const next = { ...defaults, ...(isObject(settings) ? settings : {}) };
          const hue = Number(next.hue);
          next.hue = Number.isFinite(hue) ? Math.min(360, Math.max(0, hue)) : defaults.hue;
          next.accentMode = ["white", "paper"].includes(next.accentMode) ? next.accentMode : "color";
          if (next.wallpaperMode === "fullscreen") next.wallpaperMode = "transparent";
          next.wallpaperMode = ["banner", "transparent", "solid"].includes(next.wallpaperMode) ? next.wallpaperMode : defaults.wallpaperMode;
          next.wallpaperId = wallpaperIds.includes(next.wallpaperId) ? next.wallpaperId : defaults.wallpaperId;
          next.articleLayout = ["list", "grid"].includes(next.articleLayout) ? next.articleLayout : defaults.articleLayout;
          next.sitePetId = sitePetIds.includes(next.sitePetId) ? next.sitePetId : defaults.sitePetId;
          next.bannerTitle = normalizeBoolean(next.bannerTitle, defaults.bannerTitle);
          next.particles = normalizeBoolean(next.particles, defaults.particles);
          next.homeBlackHole = normalizeBoolean(next.homeBlackHole, defaults.homeBlackHole);
          next.sitePetEnabled = normalizeBoolean(next.sitePetEnabled, defaults.sitePetEnabled);
          const particleHue = Number(next.particleHue);
          next.particleHue = Number.isFinite(particleHue) ? Math.min(360, Math.max(0, particleHue)) : defaults.particleHue;
          return next;
        };
        const read = () => {
          try {
            const raw = window.localStorage.getItem(storageKey);
            if (raw === null) return { ...defaults, accentMode: "paper" };
            return normalize(JSON.parse(raw));
          } catch {
            return { ...defaults };
          }
        };
        const apply = (settings) => {
          const next = normalize(settings);
          const root = document.documentElement;
          const hue = String(next.hue);
          root.style.setProperty("--theme-hue", hue);
          root.dataset.accentMode = next.accentMode;
          root.dataset.wallpaperMode = next.wallpaperMode;
          root.dataset.wallpaperId = next.wallpaperId;
          if (next.wallpaperId === "salvation") {
            root.style.setProperty("--appearance-wallpaper", "url('/media/wallpaper-salvation-4k-v1.webp')");
          } else if (typeof root.style.removeProperty === "function") {
            root.style.removeProperty("--appearance-wallpaper");
          }
          root.dataset.bannerTitle = next.bannerTitle ? "show" : "hide";
          root.dataset.bannerParticles = next.particles ? "on" : "off";
          root.dataset.homeBlackHole = next.homeBlackHole ? "on" : "off";
          root.dataset.particleHue = String(next.particleHue);
          root.dataset.articleLayout = next.articleLayout;
          root.dataset.sitePet = next.sitePetEnabled ? "on" : "off";
          root.dataset.sitePetId = next.sitePetId;
          return next;
        };

        window.__blogAppearance = { storageKey, defaults, normalize, read, apply };
        apply(read());
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64-v1.png" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <SiteHeader />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <SiteFooter />
      {type !== "article" && <ScrollTopButton />}
      <CardTilt />
      <OmikujiDraw />
      <ArticlePageTransition />
      <SitePet reducedActivity={type === "article"} />
    </div>
    <script>
      (function scrollReveal() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -24px 0px" }
        );

        function indexStaggerContainers() {
          document.querySelectorAll("[data-reveal-stagger]").forEach((container) => {
            container.querySelectorAll(":scope > [data-reveal]").forEach((el, i) => {
              el.style.setProperty("--reveal-i", String(i));
            });
          });
        }

        function attach() {
          indexStaggerContainers();
          document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", attach);
        } else {
          attach();
        }

        document.addEventListener("astro:after-swap", attach);
      })();
    </script>
  </body>
</html>

---
import { getTagUrl } from "../utils/blog";

type Props = {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  cover: string;
  readingTime: string;
  href: string;
};

const { title, description, date, tags, cover, readingTime, href } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<article class="surface motion-card group overflow-hidden rounded-lg">
  <a href={href} class="block">
    <img src={cover} alt={`${title} 封面`} loading="lazy" class="aspect-[16/8] w-full border-b hairline object-cover" />
  </a>
  <div class="p-5 sm:p-6">
    <div class="mb-4 flex flex-wrap items-center gap-3 text-xs text-slate-500">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <span>{readingTime}</span>
    </div>
    <a href={href} class="block">
      <h2 class="text-pretty text-xl font-semibold leading-8 text-slate-100 transition-colors group-hover:text-white">{title}</h2>
      <p class="mt-3 line-clamp-2 text-base leading-8 text-slate-400">{description}</p>
    </a>
    <div class="mt-5 flex flex-wrap gap-2">
      {tags.map((tag) => <a href={getTagUrl(tag)} class="rounded border hairline bg-[#0f1115] px-2 py-1 text-xs text-slate-400 transition-colors hover:border-sky-300/35 hover:text-slate-100">{tag}</a>)}
    </div>
  </div>
</article>

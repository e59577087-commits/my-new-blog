<div class="rain-window" data-rain-window aria-hidden="true">
  <div class="rain-window__glass">
    <video
      data-rain-video
      src="/雨夜小猫.mp4"
      poster="/雨夜小猫-poster.webp"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
    <div class="rain-window__cool-cast"></div>
    <div class="rain-window__reflection"></div>
    <div class="rain-window__theme-veil"></div>
  </div>
</div>

<style>
  .rain-window {
    --rain-video-x: 0px;
    --rain-video-y: 0px;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
    opacity: 0.22;
    filter: blur(9px) brightness(0.54);
    transform: scale(1.025);
    transition:
      opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rain-window[data-window-ready="true"] {
    opacity: 1;
    filter: blur(0) brightness(1);
    transform: scale(1);
  }

  .rain-window__glass {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #071018 url("/雨夜小猫-poster.webp") center / cover no-repeat;
  }

  .rain-window video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 1;
    filter: brightness(0.72) saturate(0.78) contrast(1.06);
    transform: scale(1.075) translate3d(var(--rain-video-x), var(--rain-video-y), 0);
    transition:
      transform 340ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease;
  }

  .rain-window[data-video-failed="true"] video {
    opacity: 0;
  }

  .rain-window__cool-cast,
  .rain-window__reflection,
  .rain-window__theme-veil {
    position: absolute;
    pointer-events: none;
  }

  .rain-window__cool-cast {
    inset: 0;
    background:
      radial-gradient(circle at 76% 34%, rgba(228, 165, 93, 0.12), transparent 24%),
      linear-gradient(130deg, rgba(78, 126, 151, 0.14), transparent 42%, rgba(2, 7, 11, 0.3));
  }

  .rain-window__reflection {
    inset: 0;
    background: linear-gradient(112deg, rgba(215, 235, 244, 0.1), transparent 24% 68%, rgba(255, 255, 255, 0.035));
    box-shadow: inset 0 0 7rem rgba(1, 4, 7, 0.58);
  }

  .rain-window__theme-veil {
    z-index: 3;
    inset: 0;
    background: linear-gradient(115deg, rgba(244, 248, 246, 0.04), rgba(244, 248, 246, 0.16));
    transition: background 420ms ease;
  }

  :global(:root[data-theme="dark"]) .rain-window__theme-veil {
    background: linear-gradient(115deg, rgba(2, 7, 12, 0.06), rgba(2, 7, 12, 0.28));
  }

  @media (max-width: 860px) {
    .rain-window video {
      object-position: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rain-window,
    .rain-window video {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }

    .rain-window video {
      animation: none;
    }
  }
</style>

<script>
  function initRainWindows() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

    document.querySelectorAll("[data-rain-window]:not([data-rain-mounted])").forEach((windowEl) => {
      if (!(windowEl instanceof HTMLElement)) return;
      windowEl.dataset.rainMounted = "true";

      const video = windowEl.querySelector("[data-rain-video]");
      const controller = new AbortController();
      const { signal } = controller;
      let frame = 0;

      const announceReady = () => {
        windowEl.dataset.windowReady = "true";
        windowEl.dispatchEvent(new CustomEvent("about-window-ready", { bubbles: true }));
      };

      if (video instanceof HTMLVideoElement) {
        video.addEventListener("error", () => {
          windowEl.dataset.videoFailed = "true";
        }, { signal });

        if (reduceMotion.matches) {
          video.pause();
          video.removeAttribute("autoplay");
        } else {
          video.play().catch(() => {
            windowEl.dataset.videoFailed = "true";
          });
        }
      }

      requestAnimationFrame(() => {
        windowEl.dataset.windowReady = "true";
        window.setTimeout(announceReady, reduceMotion.matches ? 0 : 1120);
      });

      if (!reduceMotion.matches && finePointer.matches) {
        windowEl.addEventListener("pointermove", (event) => {
          if (!(event instanceof PointerEvent)) return;
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const bounds = windowEl.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            windowEl.style.setProperty("--rain-video-x", `${x * -7}px`);
            windowEl.style.setProperty("--rain-video-y", `${y * -5}px`);
          });
        }, { signal });

        windowEl.addEventListener("pointerleave", () => {
          windowEl.style.setProperty("--rain-video-x", "0px");
          windowEl.style.setProperty("--rain-video-y", "0px");
        }, { signal });
      }

      document.addEventListener("astro:before-swap", () => controller.abort(), { once: true });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRainWindows, { once: true });
  } else {
    initRainWindows();
  }

  document.addEventListener("astro:after-swap", initRainWindows);
</script>

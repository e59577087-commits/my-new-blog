---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant: "desktop" | "mobile";
}

const { headings, variant } = Astro.props;
const rootDepth = Math.min(...headings.map((heading) => heading.depth));
---

{
  variant === "mobile" ? (
    <details class="article-toc article-toc-mobile surface-soft rounded-lg border hairline" data-article-toc="mobile">
      <summary class="heading-text cursor-pointer px-4 py-3 text-sm font-semibold">本文目录</summary>
      <nav aria-label="文章目录" class="border-t hairline px-3 py-3">
        <ol class="space-y-1 py-1">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-depth={heading.depth}
                class:list={["toc-link", heading.depth === 3 && "toc-link-nested"]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <nav aria-label="文章目录" class="article-toc article-toc-desktop" data-article-toc="desktop">
      <div class="innei-toc-rail" data-innei-toc-rail aria-hidden="true">
        <svg>
          <path data-innei-rail-path="base" d="M8 0 L8 100" />
          <path
            data-innei-rail-path="accent"
            d="M8 0 L8 100"
            stroke-linecap="round"
          />
          {headings.map((heading, index) => (
            <circle
              data-innei-rail-node
              data-heading-id={heading.slug}
              data-active={index === 0 ? "true" : "false"}
              data-root={heading.depth === rootDepth ? "true" : "false"}
              cx="8"
              cy="0"
              r={index === 0 ? "2.5" : heading.depth === rootDepth ? "1.75" : "1.25"}
            />
          ))}
        </svg>
        <div class="innei-rail-label" data-innei-rail-label>
          <span data-innei-rail-title>{headings[0]?.text}</span>
          <span data-shiro-read-percent>0%</span>
        </div>
      </div>

      <div class="article-toc-expanded">
        <ol class="article-toc-list">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-depth={heading.depth}
                class:list={["toc-link", heading.depth === 3 && "toc-link-nested"]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
        <div class="innei-toc-divider" data-innei-toc-divider aria-hidden="true">
          <svg fill="none" preserveAspectRatio="none" viewBox="0 0 28 10">
            <path
              d="M2 6.5 C4 3, 7 2.5, 9 5 C11 8, 14 8, 17 5 C19 2, 22 3, 25 6.5"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.2"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div
          class="shiro-read-indicator"
          data-shiro-read-indicator
          role="progressbar"
          aria-label="文章阅读进度"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-valuetext="阅读进度 0%"
        >
          <div class="shiro-read-value">
            <span class="shiro-read-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14">
                <circle cx="7" cy="7" r="6" fill="none" stroke="var(--color-border)" stroke-width="2" stroke-linecap="round" />
                <circle
                  data-shiro-read-circle
                  cx="7"
                  cy="7"
                  r="6"
                  fill="none"
                  stroke="var(--color-accent)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-dasharray="37.69911184307752"
                  stroke-dashoffset="37.69911184307752"
                  transform="rotate(-90 7 7)"
                />
              </svg>
            </span>
            <span data-shiro-read-percent>0%</span>
          </div>
          <button type="button" class="shiro-back-top" data-shiro-back-top data-visible="false" aria-label="回到页面顶部">
            <span class="shiro-read-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16">
                <circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.35" />
                <path d="m5.75 8.75 2.25-2.25 2.25 2.25" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span>回到顶部</span>
          </button>
        </div>
      </div>
    </nav>
  )
}

<style>
  .article-toc-desktop {
    position: relative;
    width: min(10rem, 100%);
    height: min(56vh, 34rem, calc(100vh - var(--site-header-height) - 5.75rem));
    min-height: 7.5rem;
    margin-inline-start: auto;
    color: var(--color-heading);
    font-size: 0.875rem;
    pointer-events: auto;
  }

  .article-toc-expanded {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    max-height: 75vh;
    min-height: 7.5rem;
    transform: translateX(-0.625rem);
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 300ms var(--motion-ease-standard),
      transform 350ms var(--motion-ease-standard);
  }

  .innei-toc-rail {
    position: absolute;
    inset: 0;
    opacity: 1;
    pointer-events: none;
    transition: opacity 220ms var(--motion-ease-standard) 100ms;
  }

  .innei-toc-rail > svg {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3rem;
    height: 100%;
    overflow: visible;
  }

  [data-innei-rail-path] {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  [data-innei-rail-path="base"] {
    stroke: color-mix(in srgb, var(--color-heading) 15%, transparent);
    stroke-width: 1.2;
  }

  [data-innei-rail-path="accent"] {
    stroke: var(--color-accent);
    stroke-width: 1.6;
    opacity: 0.55;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-accent) 35%, transparent));
  }

  [data-innei-rail-node] {
    fill: color-mix(in srgb, var(--color-heading) 30%, transparent);
    transition:
      r 350ms var(--motion-ease-standard),
      fill 350ms var(--motion-ease-standard);
  }

  [data-innei-rail-node][data-root="false"] {
    fill: color-mix(in srgb, var(--color-heading) 18%, transparent);
  }

  [data-innei-rail-node][data-active="true"] {
    fill: color-mix(in srgb, var(--color-accent) 70%, transparent);
  }

  .innei-rail-label {
    position: absolute;
    top: 0;
    left: 2.25rem;
    display: flex;
    max-width: 7.75rem;
    transform: translateY(50%) translateY(-50%);
    flex-direction: column;
    gap: 0.125rem;
    opacity: 1;
    font-size: 0.625rem;
    line-height: 1.25;
    transition: opacity 300ms var(--motion-ease-standard) 500ms;
  }

  .innei-rail-label [data-innei-rail-title] {
    display: block;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-heading) 40%, transparent);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .innei-rail-label [data-shiro-read-percent] {
    color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .article-toc-desktop:is(:hover, :focus-within) .article-toc-expanded {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .article-toc-desktop[data-expanded="true"] .article-toc-expanded {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .article-toc-desktop:not(:hover):not(:focus-within):not([data-expanded="true"]) .article-toc-expanded * {
    pointer-events: none;
  }

  .article-toc-desktop:is(:hover, :focus-within) .innei-toc-rail {
    opacity: 0;
    transition-delay: 0ms;
  }

  .article-toc-desktop[data-expanded="true"] .innei-toc-rail {
    opacity: 0;
    transition-delay: 0ms;
  }

  .article-toc-desktop:is(:hover, :focus-within) .innei-rail-label {
    opacity: 0;
    transition-delay: 0ms;
  }

  .article-toc-desktop[data-expanded="true"] .innei-rail-label {
    opacity: 0;
    transition-delay: 0ms;
  }

  .article-toc-list {
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .article-toc-list::-webkit-scrollbar {
    display: none;
  }

  .toc-link {
    display: block;
    position: relative;
    max-width: 100%;
    margin-bottom: 1.5px;
    padding: 0 0.25rem 0 1rem;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-heading) 75%, var(--color-page));
    font-size: 14px;
    line-height: 21px;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.35;
    transition:
      color 300ms var(--motion-ease-standard),
      opacity 300ms var(--motion-ease-standard);
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    color: var(--color-heading);
    opacity: 0.8;
    outline: none;
  }

  .toc-link[aria-current="location"] {
    color: var(--color-accent);
    font-weight: 500;
    opacity: 1;
    outline: none;
  }

  .toc-link[aria-current="location"]::before {
    content: "";
    position: absolute;
    inset-block: 3px;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .innei-toc-divider {
    position: relative;
    flex: none;
    height: 2rem;
    color: color-mix(in srgb, var(--color-heading) 12%, transparent);
  }

  .innei-toc-divider svg {
    position: absolute;
    top: 50%;
    display: block;
    width: min(9.375rem, 100%);
    height: 0.625rem;
    transform: translateY(-50%);
  }

  .shiro-read-indicator {
    padding-inline: 0.5rem;
    color: var(--color-heading);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .shiro-read-value {
    position: relative;
    padding-left: 0.875rem;
  }

  .shiro-read-icon {
    position: absolute;
    top: 50%;
    left: 0;
    display: flex;
    width: 1rem;
    height: 1rem;
    transform: translate(-0.5rem, -50%);
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
  }

  .shiro-read-icon svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  [data-shiro-read-circle] {
    transition: stroke-dashoffset 300ms var(--motion-ease-standard);
  }

  .shiro-back-top {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    margin-top: 0.25rem;
    padding-left: 0.875rem;
    opacity: 0;
    pointer-events: none;
    color: var(--color-heading);
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 500ms var(--motion-ease-standard);
  }

  .shiro-back-top[data-visible="true"] {
    opacity: 0.5;
    pointer-events: auto;
  }

  .shiro-back-top[data-visible="true"]:hover,
  .shiro-back-top[data-visible="true"]:focus-visible {
    opacity: 1;
    outline: none;
  }

  .toc-link-nested {
    padding-left: 1.75rem;
    font-size: 0.8125rem;
  }

  .article-toc-mobile summary {
    list-style-position: inside;
  }

  :global(.prose-tech :is(h2, h3)) {
    scroll-margin-top: calc(var(--site-header-height) + 1.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-link,
    .article-toc-expanded,
    .innei-toc-rail,
    .innei-rail-label,
    [data-innei-rail-node],
    [data-shiro-read-circle],
    .shiro-back-top {
      transition: none;
    }
  }
</style>

<script>
  const initializeArticleToc = () => {
    const roots = Array.from(document.querySelectorAll<HTMLElement>("[data-article-toc]"));
    if (roots.length === 0 || !("IntersectionObserver" in window)) return;

    roots
      .filter((root) => root.dataset.articleToc === "desktop")
      .forEach((root) => {
        if (root.dataset.pointerReady === "true") return;
        root.dataset.pointerReady = "true";
        root.addEventListener("pointerenter", () => {
          root.dataset.expanded = "true";
        });
        root.addEventListener("pointerleave", () => {
          root.dataset.expanded = "false";
        });
      });

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-article-toc] a[href^='#']"));
    const headingIds = links
      .map((link) => {
        try {
          return decodeURIComponent(link.hash.slice(1));
        } catch {
          return link.hash.slice(1);
        }
      })
      .filter((id, index, ids) => id && ids.indexOf(id) === index);
    const headings = headingIds
      .map((id) => document.getElementById(id))
      .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);
    if (headings.length === 0) return;

    const tocReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const railTitleAnimations = new WeakMap<HTMLElement, Animation>();
    const railTitleAnimationTokens = new WeakMap<HTMLElement, number>();

    const transitionRailTitle = (label: HTMLElement, nextTitle: string) => {
      const token = (railTitleAnimationTokens.get(label) ?? 0) + 1;
      railTitleAnimationTokens.set(label, token);
      railTitleAnimations.get(label)?.cancel();

      if (tocReducedMotion.matches || label.textContent === nextTitle) {
        label.textContent = nextTitle;
        return;
      }

      const exitAnimation = label.animate(
        [
          { opacity: 1, transform: "translateY(0)" },
          { opacity: 0, transform: "translateY(-3px)" },
        ],
        { duration: 250, easing: "ease-in", fill: "forwards" },
      );
      railTitleAnimations.set(label, exitAnimation);

      void exitAnimation.finished
        .then(() => {
          if (railTitleAnimationTokens.get(label) !== token) return;
          exitAnimation.cancel();
          label.textContent = nextTitle;

          const enterAnimation = label.animate(
            [
              { opacity: 0, transform: "translateY(3px)" },
              { opacity: 1, transform: "translateY(0)" },
            ],
            { duration: 250, easing: "ease-out" },
          );
          railTitleAnimations.set(label, enterAnimation);

          return enterAnimation.finished.then(() => {
            if (railTitleAnimationTokens.get(label) !== token) return;
            enterAnimation.cancel();
            railTitleAnimations.delete(label);
          });
        })
        .catch(() => {});
    };

    let lastActiveId = "";
    const markActive = (activeId: string) => {
      if (activeId === lastActiveId) return;
      lastActiveId = activeId;

      const activeHeading = headings.find((heading) => heading.id === activeId);
      document.querySelectorAll<HTMLElement>("[data-innei-rail-title]").forEach((label) => {
        transitionRailTitle(label, activeHeading?.textContent?.trim() || "");
      });
      document.querySelectorAll<SVGCircleElement>("[data-innei-rail-node]").forEach((node) => {
        const isActive = node.dataset.headingId === activeId;
        node.dataset.active = String(isActive);
        node.setAttribute("r", isActive ? "2.5" : node.dataset.root === "true" ? "1.75" : "1.25");
      });

      for (const link of links) {
        let id = link.hash.slice(1);
        try {
          id = decodeURIComponent(id);
        } catch {}

        if (id === activeId) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }

    };

    const updateActiveHeading = () => {
      let active = headings[0];
      const readingLine = Math.min(window.scrollY, window.innerHeight);

      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= readingLine) active = heading;
        else break;
      }

      const reachedPageEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      if (reachedPageEnd) active = headings[headings.length - 1];
      markActive(active.id);
    };

    let frame = 0;
    const scheduleActiveHeading = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateActiveHeading();
      });
    };

    const observer = new IntersectionObserver(scheduleActiveHeading, {
      rootMargin: "-96px 0px -70% 0px",
      threshold: 0,
    });

    headings.forEach((heading) => observer.observe(heading));
    window.addEventListener("scroll", scheduleActiveHeading, { passive: true });
    window.addEventListener("resize", scheduleActiveHeading, { passive: true });
    updateActiveHeading();
  };

  initializeArticleToc();
</script>

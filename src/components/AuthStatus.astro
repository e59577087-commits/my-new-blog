<div class="auth-status flex shrink-0 items-center" data-auth-status>
  <a href="/login/" data-auth-login class="auth-control inline-flex h-9 items-center rounded-md border px-3 text-sm transition-colors">
    登录
  </a>

  <div data-auth-user hidden class="items-center">
    <a href="/login/" data-auth-avatar-link class="block size-9 shrink-0 overflow-hidden rounded-full border hairline shadow-[var(--shadow-control)] transition-transform duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-border)]" title="账户设置" aria-label="账户设置">
      <img data-auth-avatar alt="用户头像" class="size-full object-cover" />
    </a>
  </div>
</div>

<script>
  const initializeAuthStatus = async () => {
    const { createBrowserSupabaseClient, getFallbackAvatar, getUserAvatar, getUserDisplayName } = await import("../lib/supabaseClient");
    const root = document.querySelector("[data-auth-status]");
    const loginLink = root?.querySelector("[data-auth-login]");
    const userBox = root?.querySelector("[data-auth-user]");
    const avatar = root?.querySelector("[data-auth-avatar]");
    const supabase = createBrowserSupabaseClient();

    const getCurrentUser = async () => {
      if (!supabase) return null;

      const { data: sessionData } = await supabase.auth.getSession();
      if (sessionData.session?.user) return sessionData.session.user;

      const { data: userData } = await supabase.auth.getUser();
      return userData.user ?? null;
    };

    const renderAuthStatus = (user) => {
      if (!loginLink || !userBox || !avatar) return;

      if (!user) {
        loginLink.hidden = false;
        userBox.hidden = true;
        userBox.classList.remove("flex");
        return;
      }

      const displayName = getUserDisplayName(user);
      loginLink.hidden = true;
      userBox.hidden = false;
      userBox.classList.add("flex");
      avatar.src = getUserAvatar(user) || getFallbackAvatar(displayName);
    };

    if (!supabase) return;

    renderAuthStatus(await getCurrentUser());

    supabase.auth.onAuthStateChange((_event, session) => {
      renderAuthStatus(session?.user ?? null);
    });

    window.addEventListener("auth-state-updated", async () => {
      renderAuthStatus(await getCurrentUser());
    });
  };

  const scheduleAuthStatus = () => {
    const run = () => void initializeAuthStatus();
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(run, { timeout: 1800 });
    } else {
      window.setTimeout(run, 250);
    }
  };

  if (document.readyState === "complete") {
    scheduleAuthStatus();
  } else {
    window.addEventListener("load", scheduleAuthStatus, { once: true });
  }
</script>

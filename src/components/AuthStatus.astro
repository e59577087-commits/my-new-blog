<div class="auth-status flex shrink-0 items-center" data-auth-status>
  <a href="/login/" data-auth-login class="auth-control inline-flex h-9 items-center rounded-md border px-3 text-sm transition-colors">
    登录
  </a>

  <div data-auth-user hidden class="auth-control h-9 items-center gap-2 rounded-md border px-2">
    <a href="/login/" data-auth-avatar-link class="block size-6 shrink-0 overflow-hidden rounded-full border hairline transition-transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-border)]" title="账户设置 / 更换头像" aria-label="账户设置">
      <img data-auth-avatar alt="用户头像" class="size-full object-cover" />
    </a>
    <span data-auth-name class="hidden max-w-24 truncate text-sm sm:inline"></span>
    <button type="button" data-auth-signout class="rounded px-2 py-1 text-sm transition-colors cursor-pointer hover:bg-[var(--color-surface-hover)]">
      退出
    </button>
  </div>
</div>

<script>
  import { createBrowserSupabaseClient, getFallbackAvatar, getUserAvatar, getUserDisplayName } from "../lib/supabaseClient";

  const root = document.querySelector("[data-auth-status]");
  const loginLink = root?.querySelector("[data-auth-login]");
  const userBox = root?.querySelector("[data-auth-user]");
  const avatar = root?.querySelector("[data-auth-avatar]");
  const name = root?.querySelector("[data-auth-name]");
  const signOutButton = root?.querySelector("[data-auth-signout]");
  const supabase = createBrowserSupabaseClient();

  const getCurrentUser = async () => {
    if (!supabase) return null;

    const { data: sessionData } = await supabase.auth.getSession();
    if (sessionData.session?.user) return sessionData.session.user;

    const { data: userData } = await supabase.auth.getUser();
    return userData.user ?? null;
  };

  const renderAuthStatus = (user) => {
    if (!loginLink || !userBox || !avatar || !name) return;

    if (!user) {
      loginLink.hidden = false;
      userBox.hidden = true;
      userBox.classList.remove("flex");
      return;
    }

    const avatarUrl = getUserAvatar(user);
    loginLink.hidden = true;
    userBox.hidden = false;
    userBox.classList.add("flex");
    name.textContent = getUserDisplayName(user);
    avatar.src = avatarUrl || getFallbackAvatar(getUserDisplayName(user));
  };

  if (supabase) {
    renderAuthStatus(await getCurrentUser());

    supabase.auth.onAuthStateChange((_event, session) => {
      renderAuthStatus(session?.user ?? null);
    });

    window.addEventListener("auth-state-updated", async () => {
      renderAuthStatus(await getCurrentUser());
    });

    signOutButton?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      renderAuthStatus(null);
    });
  }
</script>

---
import type { Article } from "../utils/articles";
import { getEntryUrl } from "../utils/articles";

type Props = {
  articles: Article[];
};

const { articles } = Astro.props;
const now = new Date();
const currentYear = now.getFullYear();
const windowStart = new Date(currentYear - 1, now.getMonth(), 1);
const startTime = windowStart.getTime();
const endTime = now.getTime();
const timeSpan = Math.max(1, endTime - startTime);

const months = Array.from({ length: 13 }, (_, index) => {
  const date = new Date(windowStart.getFullYear(), windowStart.getMonth() + index, 1);
  const month = date.getMonth();
  const season = ({ 0: "冬", 3: "春", 6: "夏", 9: "秋" } as Record<number, string>)[month];

  return {
    date,
    position: (index / 12) * 100,
    season,
    label: `${date.getFullYear()}年${month + 1}月`,
  };
});

const trailArticles = articles
  .filter((article) => {
    const time = article.data.date.getTime();
    return time >= startTime && time <= endTime;
  })
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .map((article) => {
    const rawPosition = ((article.data.date.getTime() - startTime) / timeSpan) * 100;
    const position = Math.min(99.25, Math.max(0.75, rawPosition));

    return {
      article,
      href: getEntryUrl(article),
      position,
      edge: position < 18 ? "start" : position > 82 ? "end" : "middle",
    };
  });

const latestNode = trailArticles.at(-1);
const latestArticle = latestNode?.article ?? [...articles].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const latestHref = latestArticle ? getEntryUrl(latestArticle) : undefined;
const yearCount = articles.filter((article) => article.data.date.getFullYear() === currentYear).length;
const formatNodeDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { month: "long", day: "numeric" }).format(date);
---

<section class="writing-trail" data-writing-trail data-reveal aria-labelledby="writing-trail-title">
  <div class="writing-trail-heading">
    <p class="writing-trail-kicker">WRITING TRAIL</p>
    <h2 id="writing-trail-title">笔耕不辍</h2>
  </div>

  <div class="writing-trail-scroll" data-writing-trail-scroll tabindex="0" aria-label="近一年写作时间轴，可横向滑动">
    <div class="writing-trail-canvas">
      <div class="writing-trail-axis" aria-hidden="true">
        <span class="writing-trail-line"></span>
        <span class="writing-trail-current-segment"></span>
        {
          months.map((month) => (
            <span
              class="writing-trail-month"
              style={`--trail-x: ${month.position}%`}
              title={month.label}
            >
              {month.season && <span class="writing-trail-season">{month.season}</span>}
            </span>
          ))
        }
        <span class="writing-trail-now" data-writing-trail-now>今</span>
      </div>

      <div class="writing-trail-nodes" aria-label="近一年发布的文章">
        {
          trailArticles.map(({ article, href, position, edge }) => {
            const isLatest = article.id === latestNode?.article.id;
            return (
              <a
                href={href}
                class:list={["writing-trail-node", `writing-trail-node-${edge}`, { "is-latest": isLatest }]}
                style={`--trail-x: ${position}%`}
                data-writing-trail-node
                aria-label={`阅读：${article.data.title}，${formatNodeDate(article.data.date)}`}
              >
                <span class="writing-trail-dot" aria-hidden="true"></span>
                <span class="writing-trail-tooltip" role="tooltip">
                  <span class="writing-trail-tooltip-title">{article.data.title}</span>
                  <time datetime={article.data.date.toISOString()}>{formatNodeDate(article.data.date)}</time>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

  {
    latestArticle && latestHref && (
      <p class="writing-trail-recent">
        <span>近作 · </span>
        <a href={latestHref}>{latestArticle.data.title}</a>
      </p>
    )
  }

  <p class="writing-trail-summary" data-writing-trail-year-count>
    本年 <strong>{yearCount}</strong> 篇
    <span aria-hidden="true"> · </span>
    <a href="#latest-writing">回看文章列表 <span aria-hidden="true">→</span></a>
  </p>
</section>

<script>
  const alignWritingTrails = () => {
    document.querySelectorAll<HTMLElement>("[data-writing-trail-scroll]").forEach((scroller) => {
      if (scroller.dataset.aligned === "true") return;
      scroller.scrollLeft = scroller.scrollWidth - scroller.clientWidth;
      scroller.dataset.aligned = "true";
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", alignWritingTrails, { once: true });
  } else {
    alignWritingTrails();
  }
  document.addEventListener("astro:after-swap", alignWritingTrails);
</script>

<style>
  .writing-trail {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    padding: clamp(4.5rem, 8vw, 7.5rem) 0 clamp(4.75rem, 8vw, 7rem);
    text-align: center;
  }

  .writing-trail::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 34%, var(--color-accent-soft), transparent 25%),
      radial-gradient(circle at 82% 64%, var(--color-accent-soft), transparent 24%);
    content: "";
    opacity: 0.38;
    pointer-events: none;
  }

  .writing-trail-heading,
  .writing-trail-scroll,
  .writing-trail-recent,
  .writing-trail-summary {
    position: relative;
    z-index: 1;
  }

  .writing-trail-kicker {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .writing-trail h2 {
    margin-top: 0.4rem;
    color: var(--color-heading);
    font-family: var(--font-wenkai);
    font-size: clamp(1.85rem, 3.6vw, 2.45rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.3;
  }

  .writing-trail-scroll {
    scrollbar-color: var(--color-border-strong) transparent;
    scrollbar-width: thin;
    margin-top: 1.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    outline: none;
    overscroll-behavior-inline: contain;
  }

  .writing-trail-scroll:focus-visible {
    box-shadow: inset var(--focus-ring);
  }

  .writing-trail-canvas {
    position: relative;
    width: min(90rem, calc(100vw - 4rem));
    min-width: 46rem;
    height: 8.75rem;
    margin-inline: auto;
  }

  .writing-trail-axis,
  .writing-trail-nodes {
    position: absolute;
    inset: 0;
  }

  .writing-trail-axis {
    top: 4.2rem;
    height: 1px;
  }

  .writing-trail-line,
  .writing-trail-current-segment {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
  }

  .writing-trail-line {
    background: var(--color-border-strong);
  }

  .writing-trail-current-segment {
    left: calc(100% - 8.34%);
    background: linear-gradient(90deg, transparent, var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    animation: writing-trail-draw 700ms var(--motion-ease-enter) 260ms forwards;
  }

  .writing-trail-month {
    position: absolute;
    top: 50%;
    left: var(--trail-x);
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-faint);
    transform: translate(-50%, -50%);
    opacity: 0.68;
  }

  .writing-trail-season {
    position: absolute;
    top: 1.65rem;
    left: 50%;
    color: var(--color-muted);
    font-family: var(--font-wenkai);
    font-size: 0.72rem;
    line-height: 1;
    transform: translateX(-50%);
  }

  .writing-trail-now {
    position: absolute;
    top: -1.45rem;
    right: 0;
    color: var(--color-accent-text);
    font-family: var(--font-wenkai);
    font-size: 0.72rem;
    line-height: 1;
  }

  .writing-trail-now::after {
    position: absolute;
    top: 1.15rem;
    right: 0;
    width: 1px;
    height: 0.72rem;
    background: var(--color-accent);
    content: "";
  }

  .writing-trail-node {
    position: absolute;
    top: 4.2rem;
    left: var(--trail-x);
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 999px;
    outline: none;
    transform: translate(-50%, -50%);
  }

  .writing-trail-dot {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    border: 2px solid var(--color-page-soft);
    border-radius: 999px;
    background: var(--color-muted);
    box-shadow: 0 0 0 1px var(--color-border-strong);
    transition:
      transform var(--motion-duration-fast) var(--motion-ease-enter),
      background-color var(--motion-duration-fast) ease,
      box-shadow var(--motion-duration-fast) ease;
  }

  .writing-trail-node.is-latest .writing-trail-dot {
    width: 0.56rem;
    height: 0.56rem;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
    animation: writing-trail-pulse 2.8s ease-in-out infinite;
  }

  .writing-trail-node:hover .writing-trail-dot,
  .writing-trail-node:focus-visible .writing-trail-dot {
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-soft);
    transform: scale(1.35);
  }

  .writing-trail-node:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .writing-trail-tooltip {
    position: absolute;
    bottom: calc(100% - 0.1rem);
    left: 50%;
    display: grid;
    width: max-content;
    max-width: 16rem;
    gap: 0.1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-control);
    padding: 0.48rem 0.7rem;
    color: var(--color-muted);
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.35rem);
    transition:
      opacity var(--motion-duration-fast) ease,
      transform var(--motion-duration-fast) var(--motion-ease-enter);
    backdrop-filter: blur(12px) saturate(150%);
  }

  .writing-trail-node-start .writing-trail-tooltip {
    left: 1.35rem;
    transform: translate(0, 0.35rem);
  }

  .writing-trail-node-end .writing-trail-tooltip {
    right: 1.35rem;
    left: auto;
    transform: translate(0, 0.35rem);
  }

  .writing-trail-node:hover .writing-trail-tooltip,
  .writing-trail-node:focus-visible .writing-trail-tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .writing-trail-node-start:hover .writing-trail-tooltip,
  .writing-trail-node-start:focus-visible .writing-trail-tooltip,
  .writing-trail-node-end:hover .writing-trail-tooltip,
  .writing-trail-node-end:focus-visible .writing-trail-tooltip {
    transform: translate(0, 0);
  }

  .writing-trail-tooltip-title {
    overflow: hidden;
    max-width: 14rem;
    color: var(--color-text);
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .writing-trail-tooltip time {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .writing-trail-recent {
    display: flex;
    max-width: min(46rem, calc(100% - 2rem));
    justify-content: center;
    margin: 0.25rem auto 0;
    color: var(--color-muted);
    font-size: clamp(0.82rem, 1.35vw, 0.95rem);
    line-height: 1.65;
  }

  .writing-trail-recent span {
    flex: none;
  }

  .writing-trail-recent a {
    overflow: hidden;
    color: var(--color-text);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--motion-duration-fast) ease;
  }

  .writing-trail-recent a:hover,
  .writing-trail-recent a:focus-visible,
  .writing-trail-summary a:hover,
  .writing-trail-summary a:focus-visible {
    color: var(--color-accent-text);
  }

  .writing-trail-recent a:focus-visible,
  .writing-trail-summary a:focus-visible {
    border-radius: 0.25rem;
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .writing-trail-summary {
    margin-top: 2.35rem;
    color: var(--color-faint);
    font-family: var(--font-wenkai);
    font-size: 0.86rem;
  }

  .writing-trail-summary strong {
    color: var(--color-muted);
    font-weight: 500;
  }

  .writing-trail-summary a {
    color: var(--color-accent-text);
    transition: color var(--motion-duration-fast) ease;
  }

  @keyframes writing-trail-draw {
    to { transform: scaleX(1); }
  }

  @keyframes writing-trail-pulse {
    0%, 100% { box-shadow: 0 0 0 3px var(--color-accent-soft); }
    50% { box-shadow: 0 0 0 6px transparent; }
  }

  @media (max-width: 640px) {
    .writing-trail {
      padding-block: 4rem 4.5rem;
    }

    .writing-trail-scroll {
      margin-top: 1.25rem;
    }

    .writing-trail-canvas {
      width: 42rem;
      min-width: 42rem;
      height: 8.25rem;
      margin-inline: 1rem;
    }

    .writing-trail-scroll::-webkit-scrollbar {
      display: none;
    }

    .writing-trail-scroll {
      scrollbar-width: none;
    }

    .writing-trail-summary {
      margin-top: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-trail-current-segment {
      animation: none;
      transform: none;
    }

    .writing-trail-node.is-latest .writing-trail-dot {
      animation: none;
    }
  }
</style>

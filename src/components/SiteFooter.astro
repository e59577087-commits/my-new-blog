---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t hairline">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 text-sm faint-text sm:grid-cols-[1fr_auto] sm:px-6 lg:px-8">
    <div>
      <p class="text-body">© {year} {site.author}</p>
      <p class="mt-2 max-w-xl leading-7">慢慢写，慢慢整理。这里收着一些日常片段和当下喜欢的东西。</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 sm:justify-end">
      {site.nav.map((item) => <a href={item.href} class="fine-link">{item.label}</a>)}
    </div>
  </div>
</footer>

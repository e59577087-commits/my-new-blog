---
import { SITE_PETS } from "../data/sitePets.mjs";
---

<div class="appearance-settings" data-appearance-root>
  <div class="appearance-toolbar" role="toolbar" aria-label="外观快捷设置">
    <button type="button" class="appearance-icon-button" data-appearance-toggle aria-label="打开外观设置" aria-expanded="false" aria-controls="appearance-panel">
      <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="13.5" cy="6.5" r="3.5"/>
        <path d="M7 21c-.67-.8-1.1-1.9-1.1-3 0-2.4 2.1-4.3 4.6-4.3.9 0 1.7.2 2.4.7"/>
        <path d="M12 21c-.7-.8-1.1-1.9-1.1-3 0-2.4 2.1-4.3 4.6-4.3 1.3 0 2.4.5 3.2 1.3"/>
        <path d="M10.5 2h1.5c.7 0 1.2.6 1.2 1.2v.5c0 .4-.3.8-.7.9-.8.3-1.4 1-1.4 1.9v.5"/>
        <circle cx="19.5" cy="16.5" r="2.5"/>
        <path d="M8 18c.2-.3.4-.6.5-1"/>
      </svg>
    </button>
  </div>

  <section class="appearance-panel" id="appearance-panel" data-appearance-panel hidden tabindex="-1" aria-labelledby="appearance-panel-title">
    <h2 class="sr-only" id="appearance-panel-title">外观设置</h2>
    <div class="appearance-section">
      <div class="appearance-section-title">
        <span></span>
        <h2>主题色相</h2>
        <output data-appearance-hue-output>150</output>
      </div>
      <input class="appearance-hue-slider" data-appearance-hue type="range" min="0" max="360" value="150" aria-label="主题色相" />
      <div class="appearance-swatches" data-appearance-swatches role="group" aria-label="主题色相预设">
        <button type="button" class="appearance-swatch" data-hue="0" style="--swatch-hue:0" aria-label="红色" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch" data-hue="30" style="--swatch-hue:30" aria-label="橙色" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch" data-hue="50" style="--swatch-hue:50" aria-label="金色" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch" data-hue="150" style="--swatch-hue:150" aria-label="绿色" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch" data-hue="210" style="--swatch-hue:210" aria-label="蓝色" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch" data-hue="270" style="--swatch-hue:270" aria-label="紫色" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch appearance-swatch--paper" data-accent-mode="paper" aria-label="纸白" aria-pressed="false"></button>
        <button type="button" class="appearance-swatch appearance-swatch--white" data-accent-mode="white" aria-label="纯白" aria-pressed="false"></button>
      </div>
    </div>

    <div class="appearance-section">
      <div class="appearance-section-title">
        <span></span>
        <h2>壁纸模式</h2>
      </div>
      <div class="appearance-options" data-appearance-wallpaper role="group" aria-label="壁纸模式">
        <button type="button" data-value="banner">横幅壁纸</button>
        <button type="button" data-value="transparent">全屏壁纸</button>
        <button type="button" data-value="solid">纯色背景</button>
      </div>
    </div>

    <div class="appearance-section">
      <div class="appearance-section-title">
        <span></span>
        <h2>横幅设置</h2>
      </div>
      <div class="appearance-switches">
        <label>
          <span>首页横幅标题</span>
          <input type="checkbox" data-appearance-switch="bannerTitle" />
        </label>
        <label>
          <span>横幅粒子</span>
          <input type="checkbox" data-appearance-switch="particles" />
        </label>
        <label>
          <span>首页黑洞</span>
          <input type="checkbox" data-appearance-switch="homeBlackHole" />
        </label>
      </div>
    </div>

    <div class="appearance-section" data-appearance-particle-hue-section>
      <div class="appearance-section-title">
        <span></span>
        <h2>粒子色调</h2>
        <output data-appearance-particle-hue-output>42</output>
      </div>
      <input class="appearance-hue-slider" data-appearance-particle-hue type="range" min="0" max="360" value="42" aria-label="粒子色调" />
    </div>

    <div class="appearance-section">
      <div class="appearance-section-title">
        <span></span>
        <h2>文章布局</h2>
      </div>
      <div class="appearance-segmented" data-appearance-layout role="group" aria-label="文章布局">
        <button type="button" data-value="list">列表</button>
        <button type="button" data-value="grid">网格</button>
      </div>
    </div>

    <div class="appearance-section">
      <div class="appearance-section-title">
        <span></span>
        <h2>桌面宠物</h2>
      </div>
      <div class="appearance-switches">
        <label>
          <span>显示桌宠</span>
          <input type="checkbox" data-appearance-switch="sitePetEnabled" />
        </label>
      </div>
      <div class="appearance-pet-picker" data-appearance-pet role="group" aria-label="选择桌面宠物">
        {SITE_PETS.map((pet) => (
          <button type="button" data-value={pet.id} aria-pressed="false" title={`作者：${pet.author}`}>
            <img src={pet.posterPath} alt="" width="48" height="48" loading="lazy" decoding="async" />
            <span>
              <strong>{pet.displayName}</strong>
              <small>{pet.version === 2 ? "V2 · 鼠标观察" : "V1 · 动作集"}</small>
            </span>
          </button>
        ))}
      </div>
      <p class="appearance-pet-status" data-appearance-pet-status role="status" aria-live="polite"></p>
    </div>
  </section>
</div>

<style>
  .appearance-settings {
    position: relative;
    z-index: 60;
    color: hsl(var(--theme-hue, 335) calc(42% * var(--theme-sat)) 38%);
  }

  .appearance-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .appearance-icon-button {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--glass-radius-control);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-control);
    color: var(--color-text);
    cursor: pointer;
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .appearance-icon-button:hover,
  .appearance-icon-button[aria-expanded="true"] {
    border-color: var(--color-accent-border);
    background: var(--color-surface-hover);
    color: var(--color-heading);
  }
  .appearance-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(15.5rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100vh - 6.25rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    border: 1px solid hsl(var(--theme-hue, 335) calc(76% * var(--theme-sat)) 78% / 0.38);
    border-radius: 0.85rem;
    background:
      linear-gradient(145deg, hsl(0 0% 100% / 0.84), hsl(var(--theme-hue, 335) calc(100% * var(--theme-sat)) 95% / 0.66)),
      hsl(var(--theme-hue, 335) calc(100% * var(--theme-sat)) 98% / 0.58);
    box-shadow: 0 18px 48px hsl(var(--theme-hue, 335) calc(38% * var(--theme-sat)) 32% / 0.20), 0 1px 0 hsl(0 0% 100% / 0.78) inset;
    padding: 0.65rem;
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    opacity: 0;
    transform: translate3d(0, -0.4rem, 0) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 220ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .appearance-panel[data-open] {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .appearance-section + .appearance-section {
    margin-top: 0.55rem;
  }

  .appearance-section-title {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.3rem;
  }

  .appearance-section-title span {
    width: 0.2rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--theme-primary, hsl(335 72% 58%));
  }

  .appearance-section-title h2 {
    flex: 1;
    margin: 0;
    color: var(--color-heading);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .appearance-section-title output {
    border-radius: 0.45rem;
    background: hsl(var(--theme-hue, 335) calc(82% * var(--theme-sat)) 74% / 0.20);
    padding: 0.06rem 0.35rem;
    color: hsl(var(--theme-hue, 335) calc(44% * var(--theme-sat)) 44%);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .appearance-hue-slider {
    width: 100%;
    accent-color: var(--theme-primary, hsl(335 72% 58%));
  }

  .appearance-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }

  .appearance-swatch {
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid hsl(var(--theme-hue, 335) calc(74% * var(--theme-sat)) 70% / 0.34);
    background: hsl(var(--swatch-hue, 0) 72% 58%);
    cursor: pointer;
    transition: box-shadow 160ms ease, transform 160ms ease;
  }

  .appearance-swatch:hover {
    transform: translateY(-1px);
  }

  .appearance-swatch[aria-pressed="true"] {
    box-shadow: 0 0 0 2px hsl(var(--theme-hue, 335) calc(74% * var(--theme-sat)) 50% / 0.6);
  }

  .appearance-swatch--white {
    background: linear-gradient(135deg, #ffffff, #dbe4f0);
    border-color: hsl(0 0% 82%);
  }

  .appearance-swatch--paper {
    background: linear-gradient(135deg, #fcfaf5 0 52%, #f9f6ec 52% 100%);
    border-color: #d8cdbb;
  }

  .appearance-options,
  .appearance-switches,
  .appearance-segmented {
    display: grid;
    gap: 0.3rem;
  }

  .appearance-options button,
  .appearance-segmented button,
  .appearance-switches label {
    min-height: 1.75rem;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    background: hsl(var(--theme-hue, 335) calc(100% * var(--theme-sat)) 96% / 0.56);
    color: hsl(var(--theme-hue, 335) calc(34% * var(--theme-sat)) 48%);
    font-size: 0.7rem;
    line-height: 1.25;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .appearance-options button,
  .appearance-segmented button {
    text-align: left;
    padding: 0 0.5rem;
  }

  .appearance-options button:hover,
  .appearance-segmented button:hover {
    transform: translateY(-1px);
    background: hsl(var(--theme-hue, 335) calc(100% * var(--theme-sat)) 94% / 0.74);
  }

  .appearance-options button[aria-pressed="true"],
  .appearance-segmented button[aria-pressed="true"] {
    border-color: hsl(var(--theme-hue, 335) calc(74% * var(--theme-sat)) 62% / 0.32);
    background: hsl(var(--theme-hue, 335) calc(78% * var(--theme-sat)) 84% / 0.58);
    color: hsl(var(--theme-hue, 335) calc(44% * var(--theme-sat)) 40%);
    font-weight: 650;
  }

  .appearance-switches label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0.45rem 0 0.5rem;
  }

  .appearance-switches input {
    width: 1.8rem;
    height: 1.05rem;
    accent-color: var(--theme-primary, hsl(335 72% 58%));
  }

  .appearance-segmented {
    grid-template-columns: 1fr 1fr;
  }

  .appearance-pet-picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.3rem;
    margin-top: 0.35rem;
  }

  .appearance-pet-picker button {
    display: grid;
    min-width: 0;
    justify-items: center;
    gap: 0.2rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    background: hsl(var(--theme-hue, 335) calc(100% * var(--theme-sat)) 96% / 0.56);
    padding: 0.32rem 0.2rem 0.3rem;
    color: var(--color-text-soft);
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .appearance-pet-picker button:hover {
    transform: translateY(-1px);
    background: hsl(var(--theme-hue, 335) calc(100% * var(--theme-sat)) 94% / 0.74);
  }

  .appearance-pet-picker button[aria-pressed="true"] {
    border-color: var(--color-accent-border);
    background: hsl(var(--theme-hue, 335) calc(78% * var(--theme-sat)) 84% / 0.58);
    color: var(--color-heading);
  }

  .appearance-pet-picker button[aria-busy="true"] {
    border-color: var(--color-accent-border);
    cursor: progress;
    opacity: 0.72;
  }

  .appearance-pet-status {
    margin: 0.3rem 0 0;
    min-height: 0.95rem;
    color: var(--color-text);
    font-size: 0.68rem;
    line-height: 1.35;
    text-align: center;
  }

  .appearance-pet-picker img {
    width: 2.55rem;
    height: 2.55rem;
    object-fit: contain;
  }

  .appearance-pet-picker span,
  .appearance-pet-picker strong,
  .appearance-pet-picker small {
    display: block;
    min-width: 0;
    max-width: 100%;
  }

  .appearance-pet-picker strong {
    overflow: hidden;
    font-size: 0.64rem;
    font-weight: 650;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .appearance-pet-picker small {
    margin-top: 0.08rem;
    color: var(--color-faint);
    font-size: 0.52rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  :root[data-theme="dark"] .appearance-panel {
    border-color: hsl(var(--theme-hue, 335) calc(72% * var(--theme-sat)) 64% / 0.24);
    background:
      linear-gradient(145deg, hsl(220 24% 14% / 0.92), hsl(var(--theme-hue, 335) calc(38% * var(--theme-sat)) 18% / 0.70)),
      hsl(220 24% 12% / 0.84);
    box-shadow: 0 18px 48px hsl(0 0% 0% / 0.40), 0 1px 0 hsl(0 0% 100% / 0.08) inset;
  }

  :root[data-theme="dark"] .appearance-options button,
  :root[data-theme="dark"] .appearance-segmented button,
  :root[data-theme="dark"] .appearance-switches label,
  :root[data-theme="dark"] .appearance-pet-picker button {
    background: hsl(var(--theme-hue, 335) calc(42% * var(--theme-sat)) 18% / 0.52);
    color: hsl(var(--theme-hue, 335) calc(72% * var(--theme-sat)) 84%);
  }

  :root[data-theme="dark"] .appearance-options button:hover,
  :root[data-theme="dark"] .appearance-segmented button:hover,
  :root[data-theme="dark"] .appearance-pet-picker button:hover {
    background: hsl(var(--theme-hue, 335) calc(42% * var(--theme-sat)) 24% / 0.68);
  }

  :root[data-theme="dark"] .appearance-options button[aria-pressed="true"],
  :root[data-theme="dark"] .appearance-segmented button[aria-pressed="true"],
  :root[data-theme="dark"] .appearance-pet-picker button[aria-pressed="true"] {
    border-color: hsl(var(--theme-hue, 335) calc(72% * var(--theme-sat)) 64% / 0.38);
    background: hsl(var(--theme-hue, 335) calc(58% * var(--theme-sat)) 32% / 0.62);
    color: hsl(var(--theme-hue, 335) calc(88% * var(--theme-sat)) 90%);
  }

  :root[data-theme="dark"] .appearance-section-title output {
    background: hsl(var(--theme-hue, 335) calc(62% * var(--theme-sat)) 34% / 0.28);
    color: hsl(var(--theme-hue, 335) calc(84% * var(--theme-sat)) 86%);
  }

  @media (max-width: 640px) {
    .appearance-panel {
      width: min(15rem, calc(100vw - 1.2rem));
      max-height: min(36rem, calc(100dvh - 6rem));
      border-radius: 0.7rem;
      padding: 0.45rem;
    }

    .appearance-section + .appearance-section {
      margin-top: 0.35rem;
    }

    .appearance-section-title {
      gap: 0.22rem;
      margin-bottom: 0.22rem;
    }

    .appearance-section-title span {
      height: 0.6rem;
      width: 0.18rem;
    }

    .appearance-section-title h2 {
      font-size: 0.7rem;
      line-height: 1.25;
    }

    .appearance-section-title output {
      padding: 0.04rem 0.25rem;
      font-size: 0.58rem;
      border-radius: 0.35rem;
    }

    .appearance-options,
    .appearance-switches,
    .appearance-segmented,
    .appearance-pet-picker {
      gap: 0.24rem;
    }

    .appearance-options {
      grid-template-columns: 1fr 1fr;
    }

    .appearance-options button,
    .appearance-segmented button,
    .appearance-switches label {
      min-height: 1.55rem;
      border-radius: 0.38rem;
      font-size: 0.66rem;
      line-height: 1.15;
    }

    .appearance-options button,
    .appearance-segmented button {
      padding: 0 0.38rem;
    }

    .appearance-switches label {
      gap: 0.38rem;
      padding: 0 0.35rem 0 0.4rem;
    }

    .appearance-switches input {
      width: 1.6rem;
      height: 0.9rem;
    }
  }

  @supports (height: 100dvh) {
    .appearance-panel {
      max-height: min(36rem, calc(100dvh - 6.25rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .appearance-icon-button,
    .appearance-panel,
    .appearance-options button,
    .appearance-segmented button,
    .appearance-pet-picker button {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const appearance = window.__blogAppearance;
  const root = document.querySelector("[data-appearance-root]");
  const toggle = root?.querySelector("[data-appearance-toggle]");
  const panel = root?.querySelector("[data-appearance-panel]");
  const hueInput = root?.querySelector("[data-appearance-hue]");
  const hueOutput = root?.querySelector("[data-appearance-hue-output]");
  const particleHueInput = root?.querySelector("[data-appearance-particle-hue]");
  const particleHueOutput = root?.querySelector("[data-appearance-particle-hue-output]");
  const wallpaperGroup = root?.querySelector("[data-appearance-wallpaper]");
  const layoutGroup = root?.querySelector("[data-appearance-layout]");
  const petGroup = root?.querySelector("[data-appearance-pet]");
  const petStatus = root?.querySelector("[data-appearance-pet-status]");
  const swatchGroup = root?.querySelector("[data-appearance-swatches]");
  const switches = root?.querySelectorAll("[data-appearance-switch]");

  if (appearance && root && toggle && panel && hueInput && hueOutput && wallpaperGroup && layoutGroup && switches) {
    let settings = appearance.read();

    const save = () => {
      try {
        window.localStorage.setItem(appearance.storageKey, JSON.stringify(settings));
      } catch {
        // Ignore storage failures in private or restricted browsing modes.
      }
    };

    const syncControls = () => {
      hueInput.value = String(settings.hue);
      hueOutput.textContent = String(settings.hue);

      if (particleHueInput) particleHueInput.value = String(settings.particleHue);
      if (particleHueOutput) particleHueOutput.textContent = String(settings.particleHue);

      wallpaperGroup.querySelectorAll("button").forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.value === settings.wallpaperMode ? "true" : "false");
      });

      layoutGroup.querySelectorAll("button").forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.value === settings.articleLayout ? "true" : "false");
      });

      petGroup?.querySelectorAll("button").forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.value === settings.sitePetId ? "true" : "false");
      });

      switches.forEach((input) => {
        input.checked = Boolean(settings[input.dataset.appearanceSwitch]);
      });

      if (swatchGroup) {
        swatchGroup.querySelectorAll("button").forEach((button) => {
          const accentMode = button.dataset.accentMode;
          const pressed = accentMode
            ? settings.accentMode === accentMode
            : settings.accentMode === "color" && Number(button.dataset.hue) === settings.hue;
          button.setAttribute("aria-pressed", pressed ? "true" : "false");
        });
      }
    };

    const update = (next) => {
      settings = appearance.apply({ ...settings, ...next });
      save();
      syncControls();
      window.dispatchEvent(new CustomEvent("blog:appearance-change", { detail: settings }));
    };

    const commitPetSelection = (sitePetId) => {
      settings = appearance.apply({ ...settings, sitePetId });
      save();
      syncControls();
      window.dispatchEvent(new CustomEvent("blog:appearance-change", { detail: settings }));
    };

    window.addEventListener("blog:appearance-change", (event) => {
      if (!(event instanceof CustomEvent) || !event.detail) return;
      settings = appearance.normalize(event.detail);
      syncControls();
    });

    window.addEventListener("blog:site-pet-status", (event) => {
      if (!(event instanceof CustomEvent) || !event.detail) return;
      const { status, sitePetId, displayName, message, persistSelection } = event.detail;

      petGroup?.querySelectorAll("button").forEach((button) => {
        const isLoading = status === "loading" && button.dataset.value === sitePetId;
        button.setAttribute("aria-busy", isLoading ? "true" : "false");
      });

      if (status === "ready" && persistSelection) commitPetSelection(sitePetId);
      if (!petStatus) return;
      if (status === "loading") petStatus.textContent = `正在加载${displayName}…`;
      else if (status === "error") petStatus.textContent = message || `${displayName}加载失败，请重试`;
      else if (status === "ready") petStatus.textContent = `已切换为${displayName}`;
    });

    const openPanel = () => {
      panel.hidden = false;
      requestAnimationFrame(() => {
        panel.setAttribute("data-open", "");
        toggle.setAttribute("aria-expanded", "true");
        panel.focus({ preventScroll: true });
      });
    };

    const closePanel = ({ restoreFocus = false } = {}) => {
      panel.removeAttribute("data-open");
      toggle.setAttribute("aria-expanded", "false");
      window.setTimeout(() => {
        if (!panel.hasAttribute("data-open")) panel.hidden = true;
      }, 260);
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      panel.hidden ? openPanel() : closePanel();
    });

    document.addEventListener("pointerdown", (event) => {
      if (panel.hidden || root.contains(event.target)) return;
      closePanel();
    });

    root.addEventListener("focusout", (event) => {
      if (panel.hidden) return;
      const nextTarget = event.relatedTarget;
      if (nextTarget instanceof Node && root.contains(nextTarget)) return;
      closePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        closePanel({ restoreFocus: true });
      }
    });

    hueInput.addEventListener("input", () => {
      update({ hue: Number(hueInput.value), accentMode: "color" });
    });

    particleHueInput?.addEventListener("input", () => {
      update({ particleHue: Number(particleHueInput.value) });
    });

    wallpaperGroup.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("button[data-value]") : null;
      if (!button) return;
      update({ wallpaperMode: button.dataset.value });
    });

    layoutGroup.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("button[data-value]") : null;
      if (!button) return;
      update({ articleLayout: button.dataset.value });
    });

    petGroup?.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("button[data-value]") : null;
      if (!button) return;
      if (!settings.sitePetEnabled) update({ sitePetEnabled: true });
      document.documentElement.dataset.pendingSitePetId = button.dataset.value;
      window.dispatchEvent(new CustomEvent("blog:site-pet-request", {
        detail: { sitePetId: button.dataset.value },
      }));
    });

    swatchGroup?.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("button[data-hue], button[data-accent-mode]") : null;
      if (!button) return;
      if (button.dataset.accentMode) {
        update({ accentMode: button.dataset.accentMode });
      } else {
        update({ hue: Number(button.dataset.hue), accentMode: "color" });
      }
    });

    switches.forEach((input) => {
      input.addEventListener("change", () => {
        update({ [input.dataset.appearanceSwitch]: input.checked });
      });
    });

    settings = appearance.apply(settings);
    syncControls();
  }
</script>

---
import type { Tool } from "../data/tools";

type Props = {
  tool: Tool;
};

const { tool } = Astro.props;
---

<article class="surface-soft motion-card overflow-hidden rounded-lg">
  <img src={tool.screenshot} alt={`${tool.name} 截图`} loading="lazy" class="aspect-[16/9] w-full border-b hairline object-cover" />

  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-sm text-sky-300/80">{tool.category}</p>
        <h2 class="mt-1 truncate text-xl font-semibold text-white">{tool.name}</h2>
      </div>
      <span class="grid size-9 shrink-0 place-items-center rounded-md border hairline bg-[#0f1115] font-mono text-sm text-sky-200">
        {tool.name.slice(0, 1)}
      </span>
    </div>

    <p class="mt-4 text-base leading-8 text-slate-400">{tool.description}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {tool.tags.map((tag) => <span class="rounded bg-[#0f1115] px-2 py-1 text-xs text-slate-400">{tag}</span>)}
    </div>

    <div class="mt-6 grid grid-cols-3 gap-2 border-t hairline pt-5">
      <a href={tool.url} target="_blank" rel="noreferrer" class="rounded border hairline px-3 py-2 text-center text-sm text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
        官网
      </a>
      <a href={tool.github} target="_blank" rel="noreferrer" class="rounded border hairline px-3 py-2 text-center text-sm text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
        GitHub
      </a>
      <a href={tool.download} target="_blank" rel="noreferrer" class="rounded border hairline px-3 py-2 text-center text-sm text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
        下载
      </a>
    </div>
  </div>
</article>

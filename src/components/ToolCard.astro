---
import type { Tool } from "../data/tools";

type Props = {
  tool: Tool;
};

const { tool } = Astro.props;
---

<article class="surface-soft motion-card rounded-lg p-3 sm:p-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs text-sky-300/80">{tool.category}</p>
      <h2 class="mt-1 truncate text-lg font-semibold leading-7 text-white">{tool.name}</h2>
    </div>
    <span class="grid size-8 shrink-0 place-items-center rounded-md border hairline bg-[#0f1115] font-mono text-xs text-sky-200">
      {tool.name.slice(0, 1)}
    </span>
  </div>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {tool.tags.map((tag) => <span class="rounded bg-[#0f1115] px-2 py-0.5 text-xs text-slate-400">{tag}</span>)}
  </div>
</article>

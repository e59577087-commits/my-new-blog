---
import AuthStatus from "./AuthStatus.astro";
import ThemeToggle from "./ThemeToggle.astro";
import AppearanceSettings from "./AppearanceSettings.astro";
import { site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="site-header sticky top-0 z-30 border-b hairline">
  <div class="site-header-inner mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-1.5 sm:min-h-12 sm:gap-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="group flex min-w-0 items-center gap-2.5 sm:gap-3" aria-label="返回首页">
      <span class="brand-mark grid size-8 shrink-0 place-items-center overflow-hidden rounded-md border transition-colors group-hover:border-sky-300/30">
        <img src={site.avatar} alt="" width="32" height="32" class="size-full object-cover" loading="eager" decoding="async" />
      </span>
      <span class="brand-name truncate text-sm font-medium">{site.brandName}</span>
    </a>

    <!-- Right side: desktop nav + controls -->
    <div class="header-actions flex items-center gap-1.5 sm:gap-2">
      <!-- Desktop nav (hidden on mobile) -->
      <nav class="nav-shell hidden h-9 items-center gap-1 rounded-md border p-0.5 sm:flex" aria-label="主导航">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
              "nav-link flex h-full shrink-0 items-center whitespace-nowrap rounded px-2.5 text-sm transition-colors sm:px-3.5",
                isActive(item.href) && "nav-link-active",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="hidden sm:block">
        <ThemeToggle />
      </div>
      <div class="mobile-header-auth hidden sm:block">
        <AuthStatus />
      </div>

      <!-- Hamburger button (mobile only) -->
      <button
        id="hamburger-btn"
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-md border transition-colors sm:hidden cursor-pointer hover:bg-[var(--color-surface-hover)]"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="hidden size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Appearance settings (far right) -->
      <AppearanceSettings />
    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <div id="mobile-menu" class="hidden border-t hairline sm:hidden">
    <nav class="flex flex-col gap-0.5 px-4 py-3" aria-label="移动端导航">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-md px-3 py-2.5 text-sm transition-colors",
              isActive(item.href)
                ? "bg-[var(--color-surface-hover)] text-[var(--color-heading)]"
                : "text-[var(--color-muted)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-heading)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/login/"
        class="rounded-md px-3 py-2.5 text-sm transition-colors text-[var(--color-muted)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-heading)]"
      >
        登录
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && hamburgerIcon && closeIcon) {
    const open = () => {
      menu.classList.remove('hidden');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', '关闭菜单');
    };
    const close = () => {
      menu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', '打开菜单');
    };

    btn.addEventListener('click', () => {
      menu.classList.contains('hidden') ? open() : close();
    });

    // Close menu when a nav link is clicked
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', close);
    });
  }
</script>

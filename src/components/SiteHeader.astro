---
import AuthStatus from "./AuthStatus.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="site-header sticky top-0 z-30 border-b hairline backdrop-blur-xl">
  <div class="mx-auto grid max-w-6xl gap-3 px-4 py-3 sm:flex sm:min-h-16 sm:items-center sm:justify-between sm:gap-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="返回首页">
      <span class="brand-mark grid size-8 shrink-0 place-items-center overflow-hidden rounded-md border transition-colors group-hover:border-sky-300/30">
        <img src={site.avatar} alt="" class="size-full object-cover" loading="eager" decoding="async" />
      </span>
      <span class="brand-name hidden truncate text-sm font-medium sm:block">{site.brandName}</span>
    </a>

    <div class="flex min-w-0 items-center gap-2 sm:shrink-0">
      <nav class="nav-shell flex min-w-0 flex-1 items-center gap-1 overflow-x-auto rounded-md border p-1 sm:flex-none" aria-label="主导航">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "nav-link shrink-0 whitespace-nowrap rounded px-2.5 py-1.5 text-sm transition-colors sm:px-3",
                isActive(item.href) && "nav-link-active",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
      <AuthStatus />
    </div>
  </div>
</header>

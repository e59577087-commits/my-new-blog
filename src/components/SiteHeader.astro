---
import AuthStatus from "./AuthStatus.astro";
import { site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-30 border-b hairline bg-[#0f1115]/92 backdrop-blur-xl">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="返回首页">
      <span class="grid size-8 shrink-0 place-items-center rounded-md border hairline bg-[#16181d] font-mono text-sm text-sky-200 transition-colors group-hover:border-sky-300/30">
        明
      </span>
      <span class="hidden truncate text-sm font-medium text-slate-100 sm:block">{site.name}</span>
    </a>

    <div class="flex min-w-0 shrink-0 items-center gap-2">
      <nav class="flex items-center gap-1 overflow-x-auto rounded-md border hairline bg-[#111318] p-1" aria-label="主导航">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded px-2.5 py-1.5 text-sm transition-colors sm:px-3",
                isActive(item.href)
                  ? "bg-[#16181d] text-white"
                  : "text-slate-400 hover:bg-[#16181d] hover:text-slate-100",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <AuthStatus />
    </div>
  </div>
</header>

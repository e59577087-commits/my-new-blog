<div class="omikuji-draw" data-omikuji>
  <button
    class="omikuji-trigger"
    type="button"
    aria-label="抽一支御神签"
    aria-haspopup="dialog"
    aria-controls="omikuji-dialog"
    data-omikuji-trigger
  >
    <span class="omikuji-cord" aria-hidden="true"></span>
    <span class="omikuji-knot" aria-hidden="true"></span>
    <span class="omikuji-paper" aria-hidden="true">
      <span class="omikuji-title">御神籤</span>
      <span class="omikuji-kana">おみくじ</span>
      <span class="omikuji-seal">抽</span>
    </span>
    <span class="omikuji-tassel" aria-hidden="true">
      <span></span><span></span>
    </span>
    <span class="omikuji-hint" aria-hidden="true">抽一签</span>
  </button>

  <dialog
    id="omikuji-dialog"
    class="omikuji-dialog"
    aria-labelledby="omikuji-result-title"
    data-omikuji-dialog
  >
    <article class="omikuji-result-paper" data-omikuji-result aria-live="polite">
      <button class="omikuji-close" type="button" aria-label="关闭御神签" data-omikuji-close>×</button>

      <header class="omikuji-result-header">
        <p>今日一籤</p>
        <h2 id="omikuji-result-title" data-omikuji-grade>吉</h2>
        <span aria-hidden="true">運</span>
      </header>

      <p class="omikuji-message" data-omikuji-message></p>

      <dl class="omikuji-details">
        <div>
          <dt>愿望</dt>
          <dd data-omikuji-wish></dd>
        </div>
        <div>
          <dt>学业</dt>
          <dd data-omikuji-study></dd>
        </div>
        <div>
          <dt>健康</dt>
          <dd data-omikuji-health></dd>
        </div>
        <div>
          <dt>缘分</dt>
          <dd data-omikuji-love></dd>
        </div>
      </dl>

      <footer class="omikuji-actions">
        <button class="omikuji-accept" type="button" data-omikuji-close>收下此签</button>
      </footer>
    </article>
  </dialog>
</div>

<script>
  import {
    drawOmikuji,
    getOmikujiDayKey,
    hasDrawnOmikujiToday,
    OMIKUJI_LAST_DRAW_KEY,
    type OmikujiFortune,
  } from "../utils/omikuji";

  function setText(root: HTMLElement, selector: string, value: string) {
    const target = root.querySelector<HTMLElement>(selector);
    if (target) target.textContent = value;
  }

  function renderFortune(dialog: HTMLDialogElement, fortune: OmikujiFortune) {
    dialog.dataset.tone = fortune.tone;
    setText(dialog, "[data-omikuji-grade]", fortune.grade);
    setText(dialog, "[data-omikuji-message]", fortune.message);
    setText(dialog, "[data-omikuji-wish]", fortune.wish);
    setText(dialog, "[data-omikuji-study]", fortune.study);
    setText(dialog, "[data-omikuji-health]", fortune.health);
    setText(dialog, "[data-omikuji-love]", fortune.love);
  }

  function readLastDrawDay(): string | null {
    try {
      return localStorage.getItem(OMIKUJI_LAST_DRAW_KEY);
    } catch {
      return null;
    }
  }

  function rememberTodaysDraw() {
    try {
      localStorage.setItem(OMIKUJI_LAST_DRAW_KEY, getOmikujiDayKey());
    } catch {
      // The current page still enforces one draw if storage is unavailable.
    }
  }

  function attachOmikuji(root: HTMLElement) {
    if (root.dataset.omikujiReady === "true") return;

    const trigger = root.querySelector<HTMLButtonElement>("[data-omikuji-trigger]");
    const dialog = root.querySelector<HTMLDialogElement>("[data-omikuji-dialog]");
    const closeButtons = root.querySelectorAll<HTMLButtonElement>("[data-omikuji-close]");
    if (!trigger || !dialog || closeButtons.length === 0) return;

    root.dataset.omikujiReady = "true";
    if (hasDrawnOmikujiToday(readLastDrawDay())) {
      root.dataset.drawnToday = "true";
      trigger.disabled = true;
    } else {
      root.dataset.drawnToday = "false";
    }
    let timer = 0;

    const reveal = () => {
      renderFortune(dialog, drawOmikuji());
      root.dataset.drawing = "false";
      trigger.removeAttribute("aria-busy");
      if (!dialog.open) dialog.showModal();
      rememberTodaysDraw();
      root.dataset.drawnToday = "true";
      trigger.disabled = true;
      dialog.dataset.revealed = "true";
    };

    const draw = () => {
      if (root.dataset.drawnToday === "true" || root.dataset.drawing === "true") return;

      window.clearTimeout(timer);
      root.dataset.drawing = "true";
      dialog.dataset.revealed = "false";
      trigger.setAttribute("aria-busy", "true");

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        reveal();
        return;
      }

      timer = window.setTimeout(reveal, 460);
    };

    trigger.addEventListener("click", draw);
    closeButtons.forEach((button) => {
      button.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      dialog.dataset.revealed = "false";
      if (root.dataset.drawnToday !== "true") trigger.focus({ preventScroll: true });
    });
  }

  function attachAllOmikuji() {
    document.querySelectorAll<HTMLElement>("[data-omikuji]").forEach(attachOmikuji);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", attachAllOmikuji, { once: true });
  } else {
    attachAllOmikuji();
  }
  document.addEventListener("astro:after-swap", attachAllOmikuji);
</script>


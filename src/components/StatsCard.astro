---
import { site } from "../data/site";

type Props = {
  articleCount: number;
};

const { articleCount } = Astro.props;
const startDate = site.startDate;
---

<div class="stats-card surface-soft mt-10 p-6 sm:p-8" id="stats-card">
  <div class="grid grid-cols-3 gap-4 sm:gap-6">
    <!-- 文章数 -->
    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="article-count">{articleCount}</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">篇文章</div>
    </div>

    <!-- 访问量 -->
    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="visit-count">—</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">次访问</div>
    </div>

    <!-- 运行天数 -->
    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="days-count">0</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">运行天数</div>
    </div>
  </div>
</div>

<style>
  .stats-card {
    border-radius: var(--glass-radius-card);
  }

  .stat-number {
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .stat-item {
    position: relative;
  }

  .stat-item + .stat-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    height: 76%;
    width: 1px;
    background: var(--color-border);
  }
</style>

<script>
  // 计算运行天数
  const startDate = new Date("{startDate}");
  const today = new Date();
  const diffMs = today.getTime() - startDate.getTime();
  const days = Math.max(1, Math.floor(diffMs / (1000 * 60 * 60 * 24)));
  const daysEl = document.getElementById("days-count");
  if (daysEl) {
    daysEl.textContent = String(days);
  }

  // 访问量计数 — 使用 Supabase
  const SUPABASE_URL = "https://govdfuzkcnbsnvozzqwb.supabase.co";
  const SUPABASE_KEY = "sb_publishable_OmoC6JlLIwPfcj0SsEXxNQ_fP3M_VO7";

  async function loadVisitCount() {
    const countEl = document.getElementById("visit-count");
    if (!countEl) return;

    try {
      // 获取当前总访问量
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/site_visits?id=eq.1&select=count`,
        {
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
          },
        }
      );

      if (!res.ok) throw new Error("Table not found");

      const data = await res.json();
      const currentCount = data.length > 0 ? data[0].count : 0;

      // 递增访问量
      const newCount = currentCount + 1;
      await fetch(`${SUPABASE_URL}/rest/v1/site_visits?id=eq.1`, {
        method: "PATCH",
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
          "Content-Type": "application/json",
          Prefer: "return=minimal",
        },
        body: JSON.stringify({ count: newCount }),
      });

      countEl.textContent = newCount.toLocaleString();
    } catch {
      // Supabase 表不存在时，使用 localStorage 兜底
      const key = "site_visit_count_local";
      const stored = localStorage.getItem(key);
      const localCount = stored ? parseInt(stored, 10) + 1 : 1;
      localStorage.setItem(key, String(localCount));
      countEl.textContent = localCount.toLocaleString();
    }
  }

  loadVisitCount();
</script>

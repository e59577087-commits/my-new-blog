---
import { site } from "../data/site";

type Props = {
  articleCount: number;
  totalWordCount?: number;
  variant?: "default" | "compact" | "overlay";
};

const { articleCount, totalWordCount = 0, variant = "default" } = Astro.props;
const startDate = site.startDate;
---

<div
  class:list={[
    "stats-card",
    variant === "overlay"
      ? "stats-card--overlay p-4 sm:p-5"
      : variant === "compact"
        ? "stats-card--compact surface-soft p-4 sm:p-5"
        : "surface-soft mt-10 p-6 sm:p-8",
  ]}
  id="stats-card"
  data-start-date={startDate}
>
  <div class:list={["stats-grid grid gap-4 sm:gap-6", variant !== "overlay" && "grid-cols-4"]}>
    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="article-count">{articleCount}</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">篇记录</div>
    </div>

    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="visit-count">-</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">次访问</div>
    </div>

    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="days-count">0</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">运行天数</div>
    </div>

    <div class="stat-item text-center">
      <div class="stat-icon mb-2 flex justify-center">
        <svg class="size-5 text-[var(--color-accent-text)]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25M9 13.5h6m-6 3h4.5M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div class="stat-number heading-text text-2xl font-bold sm:text-3xl" id="word-count">{totalWordCount.toLocaleString("zh-CN")}</div>
      <div class="stat-label muted mt-1 text-xs sm:text-sm">正文总字数</div>
    </div>
  </div>
</div>

<style>
  .stats-card {
    border-radius: var(--glass-radius-card);
  }

  .stats-card--overlay {
    border: 0;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-surface-solid) 86%, transparent);
    box-shadow: 0 1rem 3.2rem rgba(3, 8, 14, 0.18);
    backdrop-filter: blur(0.4rem) saturate(110%);
    -webkit-backdrop-filter: blur(0.4rem) saturate(110%);
  }

  .stats-card--overlay .stats-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .stats-card--overlay .stat-item::before {
    display: none;
  }

  .stat-number {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .stats-card--compact .stat-number {
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
  }

  .stats-card--compact .stat-icon {
    margin-bottom: 0.35rem;
  }

  .stats-card--compact .stat-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .stats-card--compact .stat-label {
    font-size: 0.7rem;
  }

  .stats-card--overlay .stat-number {
    font-size: clamp(1.05rem, 1.8vw, 1.45rem);
  }

  .stats-card--overlay .stat-label {
    font-size: 0.68rem;
  }

  :global(:root:not([data-theme="dark"])) .stats-card--overlay {
    background: rgba(248, 250, 252, 0.08);
  }

  :global(:root:not([data-theme="dark"])) .stats-card--overlay .stat-number {
    color: rgba(248, 250, 252, 0.94);
    -webkit-text-stroke: 0.5px rgba(255, 255, 255, 0.28);
    text-shadow:
      0 1px 2px rgba(1, 7, 12, 0.86),
      0 4px 14px rgba(1, 7, 12, 0.52);
  }

  :global(:root:not([data-theme="dark"])) .stats-card--overlay .stat-label {
    color: rgba(241, 245, 249, 0.82);
    text-shadow:
      0 1px 2px rgba(1, 7, 12, 0.9),
      0 3px 10px rgba(1, 7, 12, 0.5);
  }

  :global(:root:not([data-theme="dark"])) .stats-card--overlay .stat-icon :global(svg) {
    color: rgba(248, 250, 252, 0.9) !important;
    filter: drop-shadow(0 1px 2px rgba(1, 7, 12, 0.82));
  }

  .stat-item {
    position: relative;
  }

  .stat-item + .stat-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    height: 76%;
    width: 1px;
    background: var(--color-border);
  }

  @media (max-width: 640px) {
    .stats-card--overlay .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1rem;
    }
  }
</style>

<script>
  import { createBrowserSupabaseClient, isSupabaseConfigured } from "../lib/supabaseClient";

  const card = document.getElementById("stats-card");
  const startDate = new Date(card?.dataset.startDate || Date.now());
  const today = new Date();
  const diffMs = today.getTime() - startDate.getTime();
  const days = Math.max(1, Math.floor(diffMs / (1000 * 60 * 60 * 24)));
  const daysEl = document.getElementById("days-count");

  if (daysEl) {
    daysEl.textContent = String(days);
  }

  const visitCountedKey = "site_visit_count_last_counted_date";
  const getTodayKey = () => {
    const now = new Date();
    return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  };
  const getStoredVisitDate = () => {
    try {
      return window.localStorage.getItem(visitCountedKey);
    } catch {
      return null;
    }
  };
  const setStoredVisitDate = (date) => {
    try {
      window.localStorage.setItem(visitCountedKey, date);
    } catch {
      // Ignore storage failures in private or restricted browsing modes.
    }
  };
  const readVisitCount = async (supabase) => {
    const { data, error } = await supabase
      .from("site_visits")
      .select("count")
      .eq("id", 1)
      .single();

    if (error) throw error;
    return Number(data?.count ?? 0);
  };

  async function loadVisitCount() {
    const countEl = document.getElementById("visit-count");
    if (!countEl) return;

    try {
      const supabase = isSupabaseConfigured ? createBrowserSupabaseClient() : null;
      if (!supabase) throw new Error("Supabase is not configured");

      const todayKey = getTodayKey();
      const shouldIncrement = getStoredVisitDate() !== todayKey;
      let count;

      if (shouldIncrement) {
        const { data, error } = await supabase.rpc("increment_site_visit");
        if (error) throw error;
        setStoredVisitDate(todayKey);
        count = Number(data ?? 0);
      } else {
        count = await readVisitCount(supabase);
      }

      countEl.textContent = count.toLocaleString();
    } catch {
      countEl.textContent = "-";
    }
  }

  loadVisitCount();
</script>

---
import { site } from "../data/site";

const socialLinks = [
  {
    label: "博客",
    href: "https://havenofe1sar.cn/",
    icon: "blog",
  },
  {
    label: "GitHub",
    href: "https://github.com/e59577087-commits",
    icon: "github",
  },
  {
    label: "B站",
    href: "https://space.bilibili.com/527628655?spm_id_from=333.1007.0.0",
    icon: "bilibili",
  },
];
---

<aside class="profile-card surface flex flex-col items-center overflow-hidden rounded-lg p-4 sm:p-5" aria-label="个人介绍">
  <!-- Decorative top accent line -->
  <div class="profile-accent" aria-hidden="true"></div>

  <a href="/about/" class="profile-avatar-link group relative block size-16 shrink-0 overflow-hidden rounded-full border-2 hairline sm:size-18" aria-label="查看关于页">
    <img src={site.avatar} alt="" width="96" height="96" loading="eager" decoding="async" class="size-full object-cover transition-transform duration-300 group-hover:scale-105" />
    <div class="profile-avatar-ring" aria-hidden="true"></div>
  </a>

  <p class="mt-3 text-[15px] font-semibold heading-text">站主：E1sar</p>
  <p class="mt-1 text-xs muted leading-relaxed">Welcome to get to know me</p>
  <p class="mt-0.5 text-xs muted leading-relaxed">（看看我的，说不定有惊喜）</p>

  <div class="profile-social-links mt-4 flex w-full flex-col gap-1">
    {socialLinks.map((link) => (
      <a
        href={link.href}
        class="profile-social-link group flex items-center gap-3 rounded-lg px-3 py-1.5 text-sm transition-all duration-200 hover:bg-[var(--color-field)] cursor-pointer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
      >
        <span class="profile-social-icon inline-flex size-4 shrink-0 items-center justify-center muted transition-colors duration-200 group-hover:text-[var(--color-accent-text)]">
          {link.icon === "blog" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-full">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          )}
          {link.icon === "github" && (
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-full">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
          )}
          {link.icon === "bilibili" && (
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-full">
              <path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373z" />
            </svg>
          )}
        </span>
        <span class="muted text-[13px] transition-colors duration-200 group-hover:text-[var(--color-accent-text)]">{link.label}</span>
        <!-- Subtle arrow on hover -->
        <svg class="profile-link-arrow size-3 ml-auto opacity-0 transition-all duration-200 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    ))}
  </div>
</aside>

<style>
  .profile-card {
    position: relative;
    padding-top: 0;
  }

  /* Decorative gradient accent line at top */
  .profile-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent) 15%,
      hsl(calc(var(--theme-hue) + 30) 65% 62%) 50%,
      var(--color-accent) 85%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .profile-avatar-link {
    margin-top: 1rem;
  }

  /* Subtle glow ring around avatar */
  .profile-avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      var(--color-accent) 0%,
      transparent 50%,
      var(--color-accent) 100%
    );
    opacity: 0;
    transition: opacity 300ms ease;
    z-index: -1;
  }

  .profile-avatar-link:hover .profile-avatar-ring {
    opacity: 0.25;
  }

  .profile-social-links {
    border-top: 1px solid var(--color-border);
    padding-top: 0.7rem;
  }

  .profile-link-arrow {
    color: var(--color-accent-text);
  }

  :root[data-theme="dark"] .profile-accent {
    opacity: 0.85;
  }
</style>

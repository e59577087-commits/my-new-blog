<div class="bnp-root" data-bnp-root aria-hidden="true">
  <canvas data-bnp-canvas></canvas>
</div>

<style>
  .bnp-root {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: inherit;
  }

  .bnp-root canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  :root[data-banner-particles="off"] .bnp-root {
    display: none;
  }
</style>

<script>
  (function bannerParticles() {
    const mql = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mql.matches) return;

    const container = document.querySelector("[data-bnp-root]");
    if (!container) return;

    const canvas = container.querySelector("canvas");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const root = document.documentElement;

    // ── Read current particle hue from root ────────────
    function getParticleHue() {
      const raw = root.dataset.particleHue;
      const n = Number(raw);
      return Number.isFinite(n) ? Math.min(360, Math.max(0, n)) : 42;
    }

    function isEnabled() {
      return root.dataset.bannerParticles !== "off";
    }

    // ── Color palette generator ────────────────────────
    function buildPalette(hue) {
      return [
        `hsla(${hue}, 70%, 78%, 0.48)`,
        `hsla(${(hue - 6 + 360) % 360}, 58%, 72%, 0.38)`,
        `hsla(${(hue + 2) % 360}, 74%, 82%, 0.32)`,
        `hsla(${(hue - 12 + 360) % 360}, 52%, 68%, 0.42)`,
        `hsla(${(hue - 2 + 360) % 360}, 62%, 80%, 0.28)`,
        `hsla(${(hue + 6) % 360}, 55%, 75%, 0.35)`,
      ];
    }

    let palette = buildPalette(getParticleHue());

    // ── Particle ───────────────────────────────────────
    const COUNT = 42;

    class Particle {
      constructor(w, h) {
        this.reset(w, h, true);
      }

      reset(w, h, randomY) {
        this.x = Math.random() * w;
        this.y = randomY ? Math.random() * h : h + 8;
        this.r = 0.6 + Math.random() * 2.8;
        this.color = palette[(Math.random() * palette.length) | 0];

        const speed = 0.12 + Math.random() * 0.32;
        const angle = -Math.PI / 2 + (Math.random() - 0.5) * 0.5;
        this.vx = Math.cos(angle) * speed;
        this.vy = Math.sin(angle) * speed;

        this.twinkleSpeed = 0.006 + Math.random() * 0.022;
        this.twinkleOffset = Math.random() * Math.PI * 2;
        this.baseAlpha = 0.18 + Math.random() * 0.52;
      }

      recolor() {
        this.color = palette[(Math.random() * palette.length) | 0];
      }

      update(w, h, mx, my, interactDist) {
        this.x += this.vx;
        this.y += this.vy;

        if (mx != null && my != null) {
          const dx = this.x - mx;
          const dy = this.y - my;
          const dist = Math.hypot(dx, dy);
          if (dist < interactDist) {
            const force = (1 - dist / interactDist) * 0.9;
            this.x += (dx / dist) * force * 2.8;
            this.y += (dy / dist) * force * 2.8;
          }
        }

        if (this.y < -10) { this.y = h + 8; this.x = Math.random() * w; }
        if (this.y > h + 10) { this.y = -8; this.x = Math.random() * w; }
        if (this.x < -10) this.x = w + 8;
        if (this.x > w + 10) this.x = -8;
      }

      draw(ctx, time) {
        const twinkle = Math.sin(time * this.twinkleSpeed + this.twinkleOffset) * 0.5 + 0.5;
        const alpha = this.baseAlpha * (0.5 + twinkle * 0.5);
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.fillStyle = this.color.replace(/[\d.]+\)$/, `${alpha.toFixed(3)})`);
        ctx.fill();
      }
    }

    // ── Resize ─────────────────────────────────────────
    function resize() {
      const rect = container.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const w = rect.width;
      const h = rect.height;

      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + "px";
        canvas.style.height = h + "px";

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        particles.length = 0;
        for (let i = 0; i < COUNT; i++) {
          particles.push(new Particle(w, h));
        }
      }
    }

    // ── Init ───────────────────────────────────────────
    const particles = [];
    resize();
    for (let i = 0; i < COUNT; i++) {
      particles.push(new Particle(canvas.width / (window.devicePixelRatio || 1), canvas.height / (window.devicePixelRatio || 1)));
    }

    // ── Mouse tracking ─────────────────────────────────
    let mx = null;
    let my = null;
    const INTERACT_DIST = 110;

    container.parentElement?.addEventListener("mousemove", (e) => {
      const rect = container.getBoundingClientRect();
      mx = e.clientX - rect.left;
      my = e.clientY - rect.top;
    });

    container.parentElement?.addEventListener("mouseleave", () => {
      mx = null;
      my = null;
    });

    // ── Animation ──────────────────────────────────────
    let time = 0;
    let animId;

    function loop(ts) {
      animId = requestAnimationFrame(loop);
      time = ts;

      const w = canvas.width / (window.devicePixelRatio || 1);
      const h = canvas.height / (window.devicePixelRatio || 1);

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (const p of particles) {
        p.update(w, h, mx, my, INTERACT_DIST);
        p.draw(ctx, time);
      }
    }

    // Start animation only if enabled
    if (isEnabled()) {
      animId = requestAnimationFrame(loop);
    }

    // ── React to hue changes & enable/disable ──────────
    const attrObserver = new MutationObserver(() => {
      const enabled = isEnabled();
      const newHue = getParticleHue();

      if (palette[0] !== buildPalette(newHue)[0]) {
        palette = buildPalette(newHue);
        particles.forEach((p) => p.recolor());
      }

      if (enabled && !animId) {
        animId = requestAnimationFrame(loop);
      } else if (!enabled && animId) {
        cancelAnimationFrame(animId);
        animId = null;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    });

    attrObserver.observe(root, {
      attributes: true,
      attributeFilter: ["data-banner-particles", "data-particle-hue"],
    });

    // ── Visibility observer ────────────────────────────
    let wasHidden = false;
    const visObserver = new IntersectionObserver(
      (entries) => {
        const hidden = !entries[0].isIntersecting;
        if (hidden && !wasHidden) {
          wasHidden = true;
          if (animId) {
            cancelAnimationFrame(animId);
            animId = null;
          }
        } else if (!hidden && wasHidden) {
          wasHidden = false;
          if (isEnabled() && !animId) {
            animId = requestAnimationFrame(loop);
          }
        }
      },
      { threshold: 0 }
    );
    visObserver.observe(container);

    window.addEventListener("resize", resize);
  })();
</script>

---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<section class="mt-14 border-t hairline pt-8" data-comments data-post-slug={slug}>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="kicker text-sm font-medium">评论</p>
      <h2 class="heading-text mt-1 text-2xl font-semibold">
        文章讨论
        <span data-comment-count class="faint-text text-base font-normal"></span>
      </h2>
    </div>
    <a href="/login/" data-comment-login-link class="secondary-button rounded-md border px-4 py-2 text-sm transition-colors">
      登录后评论
    </a>
  </div>

  <div data-comment-config-missing hidden class="notice-box mt-5 rounded-md border p-4 text-sm leading-7">
    评论功能尚未配置。请先设置 Supabase 环境变量。
  </div>

  <form data-comment-form hidden class="mt-6">
    <label for={`comment-${slug}`} class="heading-text text-sm font-medium">留下你的评论</label>
    <textarea
      id={`comment-${slug}`}
      data-comment-input
      rows="4"
      maxlength="1200"
      required
      placeholder="写点什么..."
      class="input-control mt-3 min-h-28 w-full resize-y rounded-md border px-3 py-2.5 text-sm outline-none transition"
    ></textarea>
    <div class="mt-3 flex items-center justify-between gap-3">
      <p data-comment-message class="body-text text-sm leading-6" aria-live="polite"></p>
      <button type="submit" data-comment-submit class="primary-button shrink-0 rounded-md border px-4 py-2.5 text-sm font-medium transition-colors">
        发表评论
      </button>
    </div>
  </form>

  <p data-comment-signed-out class="body-text mt-5 text-sm leading-7">
    登录后可以发表评论。
  </p>

  <div data-comment-loading class="body-text mt-6 text-sm">正在加载评论...</div>
  <div data-comment-empty hidden class="body-text mt-6 rounded-md border hairline bg-[var(--color-surface-soft)] p-4 text-sm">
    还没有评论。
  </div>
  <div data-comment-list class="mt-6 space-y-4"></div>
</section>

<script>
  const initializeComments = async () => {
    const { createBrowserSupabaseClient, getFallbackAvatar, getUserAvatar, getUserDisplayName, isSupabaseConfigured } = await import("../lib/supabaseClient");

    const createCommentElement = (comment, currentUser) => {
    const article = document.createElement("article");
    article.className = "surface-soft rounded-lg p-4";

    const header = document.createElement("div");
    header.className = "flex items-start gap-3";

    const avatar = document.createElement("img");
    const authorName = comment.author_name || "已登录用户";
    avatar.alt = "";
    avatar.src = comment.author_avatar || getFallbackAvatar(authorName);
    avatar.className = "size-10 shrink-0 rounded-md border hairline object-cover";

    const body = document.createElement("div");
    body.className = "min-w-0 flex-1";

    const meta = document.createElement("div");
    meta.className = "flex flex-wrap items-center gap-x-3 gap-y-1";

    const name = document.createElement("p");
    name.className = "heading-text truncate text-sm font-medium";
    name.textContent = authorName;

    const time = document.createElement("time");
    time.className = "faint-text text-xs";
    time.dateTime = comment.created_at;
    time.textContent = new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(comment.created_at));

    meta.append(name, time);

    const content = document.createElement("p");
    content.className = "text-body mt-2 whitespace-pre-wrap break-words text-sm leading-7";
    content.textContent = comment.content;

    body.append(meta, content);

    if (currentUser?.id === comment.user_id) {
      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "secondary-button mt-3 rounded-md border px-3 py-1.5 text-xs transition-colors";
      deleteButton.textContent = "删除";
      deleteButton.dataset.commentDelete = String(comment.id);
      body.append(deleteButton);
    }

    header.append(avatar, body);
    article.append(header);
    return article;
    };

    const getCurrentUser = async (supabase) => {
      const { data: sessionData } = await supabase.auth.getSession();
      if (sessionData.session?.user) return sessionData.session.user;

      const { data: userData } = await supabase.auth.getUser();
      return userData.user ?? null;
    };

    document.querySelectorAll("[data-comments]").forEach((root) => {
    const supabase = createBrowserSupabaseClient();
    const postSlug = root.getAttribute("data-post-slug");
    const configMissing = root.querySelector("[data-comment-config-missing]");
    const loginLink = root.querySelector("[data-comment-login-link]");
    const form = root.querySelector("[data-comment-form]");
    const input = root.querySelector("[data-comment-input]");
    const submitButton = root.querySelector("[data-comment-submit]");
    const signedOut = root.querySelector("[data-comment-signed-out]");
    const loading = root.querySelector("[data-comment-loading]");
    const empty = root.querySelector("[data-comment-empty]");
    const list = root.querySelector("[data-comment-list]");
    const count = root.querySelector("[data-comment-count]");
    const message = root.querySelector("[data-comment-message]");
    let currentUser = null;
    let comments = [];

    const setMessage = (text) => {
      if (message) message.textContent = text;
    };

    const setSubmitting = (isSubmitting) => {
      if (!submitButton) return;
      submitButton.disabled = isSubmitting;
      submitButton.textContent = isSubmitting ? "发布中..." : "发表评论";
    };

    const renderAuth = () => {
      const isSignedIn = Boolean(currentUser);
      if (form) form.hidden = !isSignedIn;
      if (signedOut) signedOut.hidden = isSignedIn;
      if (loginLink) loginLink.hidden = isSignedIn;
    };

    const renderComments = () => {
      if (!list || !empty || !count) return;

      list.replaceChildren(...comments.map((comment) => createCommentElement(comment, currentUser)));
      empty.hidden = comments.length > 0;
      count.textContent = `（${comments.length}）`;
    };

    const loadComments = async () => {
      if (!supabase || !postSlug) return;
      if (loading) loading.hidden = false;

      const { data, error } = await supabase
        .from("comments")
        .select("id, post_slug, user_id, content, author_name, author_avatar, created_at")
        .eq("post_slug", postSlug)
        .order("created_at", { ascending: true });

      if (loading) loading.hidden = true;

      if (error) {
        setMessage(`评论加载失败：${error.message}`);
        return;
      }

      comments = data ?? [];
      renderComments();
    };

    const refreshAuth = async () => {
      if (!supabase) return;
      currentUser = await getCurrentUser(supabase);
      renderAuth();
      renderComments();
    };

    if (!isSupabaseConfigured || !supabase) {
      if (configMissing) configMissing.hidden = false;
      if (loading) loading.hidden = true;
      if (loginLink) loginLink.hidden = true;
      if (signedOut) signedOut.hidden = true;
      return;
    }

    refreshAuth();
    loadComments();

    supabase.auth.onAuthStateChange((_event, session) => {
      currentUser = session?.user ?? null;
      renderAuth();
      renderComments();
    });

    window.addEventListener("auth-state-updated", refreshAuth);

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!supabase || !postSlug || !currentUser || !input) return;

      const content = input.value.trim();
      if (!content) {
        setMessage("请先输入评论内容。");
        return;
      }

      setSubmitting(true);
      setMessage("");
      const authorName = getUserDisplayName(currentUser);
      const { error } = await supabase.from("comments").insert({
        post_slug: postSlug,
        user_id: currentUser.id,
        content,
        author_name: authorName,
        author_avatar: getUserAvatar(currentUser) || getFallbackAvatar(authorName),
      });
      setSubmitting(false);

      if (error) {
        setMessage(`发布失败：${error.message}`);
        return;
      }

      input.value = "";
      setMessage("评论已发布。");
      await loadComments();
    });

    list?.addEventListener("click", async (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("[data-comment-delete]") : null;
      const id = button?.getAttribute("data-comment-delete");
      if (!supabase || !id) return;

      button.setAttribute("disabled", "true");
      const { error } = await supabase.from("comments").delete().eq("id", id);
      if (error) {
        button.removeAttribute("disabled");
        setMessage(`删除失败：${error.message}`);
        return;
      }

      setMessage("评论已删除。");
      await loadComments();
    });
    });
  };

  const scheduleComments = () => {
    const run = () => void initializeComments();
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(run, { timeout: 1400 });
    } else {
      window.setTimeout(run, 250);
    }
  };

  if (document.readyState === "complete") {
    scheduleComments();
  } else {
    window.addEventListener("load", scheduleComments, { once: true });
  }
</script>

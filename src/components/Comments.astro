---
type Props = {
  postSlug: string;
};

const { postSlug } = Astro.props;
---

<section class="mt-14 border-t hairline pt-8" data-comments data-post-slug={postSlug}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm text-sky-300/90">评论</p>
      <h2 class="mt-1 text-2xl font-semibold text-white">参与讨论</h2>
    </div>
    <a href="/login/" data-comments-login class="fine-link text-sm">登录后发表评论</a>
  </div>

  <div data-comments-config-missing hidden class="mt-5 rounded-md border hairline bg-[#111318] p-4 text-sm leading-7 text-slate-300">
    评论功能尚未配置。请先在 `.env` 中填写 Supabase 项目的 `PUBLIC_SUPABASE_URL` 和 `PUBLIC_SUPABASE_ANON_KEY`。
  </div>

  <form data-comment-form hidden class="mt-6 rounded-lg border hairline bg-[#111318] p-4 sm:p-5">
    <label for="comment-content" class="text-sm font-medium text-slate-200">写评论</label>
    <textarea
      id="comment-content"
      data-comment-input
      required
      maxlength="1000"
      rows="4"
      placeholder="写下你的想法..."
      class="mt-3 w-full resize-y rounded-md border hairline bg-[#0f1115] px-3 py-2.5 text-sm leading-7 text-slate-100 outline-none transition-colors placeholder:text-slate-600 focus:border-sky-300/40"
    ></textarea>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-slate-500">最多 1000 字。</p>
      <button type="submit" data-comment-submit class="rounded-md border hairline bg-slate-100 px-4 py-2.5 text-sm font-medium text-[#0f1115] transition-colors hover:bg-white disabled:cursor-not-allowed disabled:opacity-60">
        发布评论
      </button>
    </div>
  </form>

  <p data-comments-message class="mt-5 text-sm leading-7 text-slate-400" aria-live="polite">正在加载评论...</p>
  <div data-comments-list class="mt-5 space-y-4"></div>
</section>

<script>
  import { createBrowserSupabaseClient, getFallbackAvatar, getUserAvatar, getUserDisplayName, isSupabaseConfigured } from "../lib/supabaseClient";

  const root = document.querySelector("[data-comments]");
  const postSlug = root?.getAttribute("data-post-slug");
  const configMissing = root?.querySelector("[data-comments-config-missing]");
  const loginLink = root?.querySelector("[data-comments-login]");
  const form = root?.querySelector("[data-comment-form]");
  const input = root?.querySelector("[data-comment-input]");
  const submitButton = root?.querySelector("[data-comment-submit]");
  const message = root?.querySelector("[data-comments-message]");
  const list = root?.querySelector("[data-comments-list]");
  const supabase = createBrowserSupabaseClient();

  let currentUser = null;

  const setMessage = (text) => {
    if (message) message.textContent = text;
  };

  const formatCommentDate = (value) =>
    new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));

  const renderAuthState = (user) => {
    currentUser = user;

    if (!loginLink || !form) return;

    if (!user) {
      loginLink.hidden = false;
      form.hidden = true;
      return;
    }

    loginLink.hidden = true;
    form.hidden = false;
  };

  const renderComments = (comments) => {
    if (!list) return;

    list.replaceChildren();

    if (!comments.length) {
      setMessage("还没有评论，登录后可以发布第一条。");
      return;
    }

    setMessage(`${comments.length} 条评论`);

    comments.forEach((comment) => {
      const authorName = comment.author_name || "已登录用户";
      const item = document.createElement("article");
      item.className = "rounded-lg border hairline bg-[#111318] p-4";

      const header = document.createElement("div");
      header.className = "flex items-center gap-3";

      const avatar = document.createElement("img");
      avatar.className = "size-9 rounded-md border hairline bg-[#16181d] object-cover";
      avatar.alt = `${authorName} 头像`;
      avatar.src = comment.author_avatar || getFallbackAvatar(authorName);

      const meta = document.createElement("div");
      meta.className = "min-w-0";

      const name = document.createElement("p");
      name.className = "truncate text-sm font-medium text-slate-100";
      name.textContent = authorName;

      const date = document.createElement("time");
      date.className = "block text-xs text-slate-500";
      date.dateTime = comment.created_at;
      date.textContent = formatCommentDate(comment.created_at);

      const content = document.createElement("p");
      content.className = "mt-4 whitespace-pre-wrap text-sm leading-7 text-slate-300";
      content.textContent = comment.content;

      meta.append(name, date);
      header.append(avatar, meta);
      item.append(header, content);
      list.append(item);
    });
  };

  const loadComments = async () => {
    if (!supabase || !postSlug) return;

    setMessage("正在加载评论...");
    const { data, error } = await supabase
      .from("comments")
      .select("id, content, author_name, author_avatar, created_at, user_id")
      .eq("post_slug", postSlug)
      .order("created_at", { ascending: true });

    if (error) {
      renderComments([]);
      setMessage(`评论加载失败：${error.message}`);
      return;
    }

    renderComments(data ?? []);
  };

  if (!isSupabaseConfigured || !supabase) {
    if (configMissing) configMissing.hidden = false;
    setMessage("配置完成后，这里会显示文章评论。");
  } else {
    const { data } = await supabase.auth.getSession();
    renderAuthState(data.session?.user ?? null);
    await loadComments();

    supabase.auth.onAuthStateChange((_event, session) => {
      renderAuthState(session?.user ?? null);
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const content = input?.value?.trim();
      if (!content || !currentUser || !postSlug) return;

      submitButton.disabled = true;
      setMessage("正在发布评论...");

      const authorName = getUserDisplayName(currentUser);
      const authorAvatar = getUserAvatar(currentUser);
      const { error } = await supabase.from("comments").insert({
        post_slug: postSlug,
        user_id: currentUser.id,
        content,
        author_name: authorName,
        author_avatar: authorAvatar,
      });

      submitButton.disabled = false;

      if (error) {
        setMessage(`发布失败：${error.message}`);
        return;
      }

      input.value = "";
      await loadComments();
    });
  }
</script>

<section class="auth-panel surface rounded-lg p-5 sm:p-6" data-auth-panel>
  <div data-auth-config-missing hidden class="notice-box rounded-md border p-4 text-sm leading-7">
    登录功能尚未配置。请先在 `.env` 中填写 Supabase 项目的 `PUBLIC_SUPABASE_URL` 和 `PUBLIC_SUPABASE_ANON_KEY`。
  </div>

  <div data-auth-signed-out>
    <div>
      <p class="kicker text-sm font-medium">账户登录</p>
      <h2 class="heading-text mt-2 text-2xl font-semibold">登录后同步你的身份状态</h2>
      <p class="body-text mt-3 text-base leading-8">登录后可以保留同一个身份，之后如果再开放互动内容，也能直接继续使用。</p>
    </div>

    <div class="mt-7 grid gap-3 sm:grid-cols-2">
      <button type="button" data-oauth-provider="github" class="provider-button rounded-md border px-4 py-3 text-left text-sm font-medium transition-colors">
        使用 GitHub 登录
      </button>
      <button type="button" data-oauth-provider="google" class="provider-button rounded-md border px-4 py-3 text-left text-sm font-medium transition-colors">
        使用 Google 登录
      </button>
    </div>

    <form data-email-form class="auth-divider mt-7 border-t pt-6">
      <label for="auth-email" class="heading-text text-sm font-medium">邮箱验证码登录</label>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row">
        <input
          id="auth-email"
          data-email-input
          type="email"
          required
          placeholder="name@example.com"
          class="input-control min-w-0 flex-1 rounded-md border px-3 py-2.5 text-sm outline-none transition"
        />
        <button data-send-otp type="submit" class="primary-button rounded-md border px-4 py-2.5 text-sm font-medium transition-colors">
          发送验证码
        </button>
      </div>
    </form>

    <form data-otp-form hidden class="mt-5">
      <label for="auth-otp" class="heading-text text-sm font-medium">8 位验证码</label>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row">
        <input
          id="auth-otp"
          data-otp-input
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{8}"
          maxlength="8"
          required
          placeholder="00000000"
          class="input-control min-w-0 flex-1 rounded-md border px-3 py-2.5 text-sm outline-none transition"
        />
        <button type="submit" class="primary-button rounded-md border px-4 py-2.5 text-sm font-medium transition-colors">
          验证登录
        </button>
      </div>
      <button
        data-resend-otp
        type="button"
        class="secondary-button mt-3 rounded-md border px-4 py-2.5 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-60"
      >
        重新发送验证码
      </button>
    </form>
  </div>

  <div data-auth-signed-in hidden>
    <div class="flex items-start gap-4">
      <div class="relative shrink-0">
        <button
          type="button"
          data-avatar-change
          class="group/avatar relative block size-14 overflow-hidden rounded-lg border hairline focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-border)]"
          title="点击更换头像"
        >
          <img data-panel-avatar alt="用户头像" class="size-full object-cover" />
          <div class="absolute inset-0 flex items-center justify-center bg-black/0 transition-all duration-200 group-hover/avatar:bg-black/40" aria-hidden="true">
            <svg data-avatar-camera viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-white opacity-0 transition-opacity duration-200 group-hover/avatar:opacity-100">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
              <circle cx="12" cy="13" r="4" />
            </svg>
          </div>
          <div data-avatar-progress class="absolute bottom-0 left-0 h-1 bg-[var(--color-accent)] transition-all duration-300" style="width:0%" hidden></div>
        </button>
        <input type="file" data-avatar-input accept="image/jpeg,image/png,image/webp,image/gif" hidden />
      </div>
      <div class="min-w-0 flex-1">
        <p class="kicker text-sm font-medium">已登录</p>
        <h2 data-panel-name class="heading-text mt-1 truncate text-2xl font-semibold"></h2>
        <p data-panel-email class="faint-text mt-1 truncate text-sm"></p>
      </div>
    </div>

    <p data-avatar-hint class="faint-text mt-2 text-xs leading-5">点击头像可更换，支持 JPG / PNG / WebP / GIF，不超过 2 MB</p>

    <div class="mt-5 flex flex-wrap gap-3">
      <button type="button" data-panel-avatar-reset hidden class="secondary-button rounded-md border px-3 py-2 text-sm transition-colors">
        恢复默认头像
      </button>
      <button type="button" data-panel-signout class="secondary-button rounded-md border px-4 py-2.5 text-sm transition-colors">
        退出登录
      </button>
    </div>
  </div>

  <p data-auth-message class="body-text mt-5 text-sm leading-7" aria-live="polite"></p>
</section>

<script>
  import { createBrowserSupabaseClient, getFallbackAvatar, getUserAvatar, getUserDisplayName, getUserOriginalAvatar, isSupabaseConfigured, resetUserAvatar, uploadUserAvatar } from "../lib/supabaseClient";

  const panel = document.querySelector("[data-auth-panel]");
  const configMissing = panel?.querySelector("[data-auth-config-missing]");
  const signedOut = panel?.querySelector("[data-auth-signed-out]");
  const signedIn = panel?.querySelector("[data-auth-signed-in]");
  const message = panel?.querySelector("[data-auth-message]");
  const avatar = panel?.querySelector("[data-panel-avatar]");
  const name = panel?.querySelector("[data-panel-name]");
  const email = panel?.querySelector("[data-panel-email]");
  const signOutButton = panel?.querySelector("[data-panel-signout]");
  const emailForm = panel?.querySelector("[data-email-form]");
  const emailInput = panel?.querySelector("[data-email-input]");
  const sendOtpButton = panel?.querySelector("[data-send-otp]");
  const otpForm = panel?.querySelector("[data-otp-form]");
  const otpInput = panel?.querySelector("[data-otp-input]");
  const resendOtpButton = panel?.querySelector("[data-resend-otp]");
  const avatarChangeButton = panel?.querySelector("[data-avatar-change]");
  const avatarInput = panel?.querySelector("[data-avatar-input]") as HTMLInputElement | null;
  const avatarProgress = panel?.querySelector("[data-avatar-progress]") as HTMLElement | null;
  const avatarResetButton = panel?.querySelector("[data-panel-avatar-reset]") as HTMLButtonElement | null;
  const avatarHint = panel?.querySelector("[data-avatar-hint]") as HTMLElement | null;
  const supabase = createBrowserSupabaseClient();
  const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/+$/, "");
  let currentUser: any = null;

  const getRedirectTo = () => `${configuredSiteUrl || window.location.origin}/login`;
  let currentEmail = "";
  let resendSeconds = 0;
  let resendTimer;

  const setMessage = (text) => {
    if (message) message.textContent = text;
  };

  const normalizeEmail = (value) => value?.trim().toLowerCase() ?? "";

  const notifyAuthUpdated = () => {
    window.dispatchEvent(new CustomEvent("auth-state-updated"));
  };

  const setSending = (isSending) => {
    if (!sendOtpButton) return;
    sendOtpButton.disabled = isSending;
    sendOtpButton.textContent = isSending ? "正在发送..." : "发送验证码";
  };

  const setVerifying = (isVerifying) => {
    const verifyButton = otpForm?.querySelector("button[type='submit']");
    if (!verifyButton) return;
    verifyButton.disabled = isVerifying;
    verifyButton.textContent = isVerifying ? "正在验证..." : "验证登录";
  };

  const updateResendButton = () => {
    const isCoolingDown = resendSeconds > 0;

    if (sendOtpButton) {
      sendOtpButton.disabled = isCoolingDown;
      sendOtpButton.textContent = isCoolingDown ? `${resendSeconds} 秒后重新发送` : "发送验证码";
    }

    if (!resendOtpButton) return;
    resendOtpButton.disabled = isCoolingDown;
    resendOtpButton.textContent = isCoolingDown ? `${resendSeconds} 秒后重新发送` : "重新发送验证码";
  };

  const startResendCountdown = () => {
    window.clearInterval(resendTimer);
    resendSeconds = 60;
    updateResendButton();

    resendTimer = window.setInterval(() => {
      resendSeconds -= 1;
      updateResendButton();

      if (resendSeconds <= 0) {
        window.clearInterval(resendTimer);
      }
    }, 1000);
  };

  const showOtpForm = () => {
    if (!otpForm) return;
    otpForm.hidden = false;
    otpInput?.focus();
  };

  const sendEmailOtp = async (targetEmail) => {
    const normalizedEmail = normalizeEmail(targetEmail);
    if (!supabase || !normalizedEmail) return false;

    setSending(true);
    setMessage("正在发送邮箱验证码...");
    const { error } = await supabase.auth.signInWithOtp({
      email: normalizedEmail,
    });
    setSending(false);

    if (error) {
      setMessage(`发送失败：${error.message}`);
      return false;
    }

    currentEmail = normalizedEmail;
    if (emailInput) emailInput.value = normalizedEmail;
    if (otpInput) otpInput.value = "";
    showOtpForm();
    startResendCountdown();
    setMessage(`验证码已发送至 ${normalizedEmail}，请检查邮箱。`);
    return true;
  };

  const getCurrentUser = async () => {
    if (!supabase) return null;

    const { data: sessionData } = await supabase.auth.getSession();
    if (sessionData.session?.user) return sessionData.session.user;

    const { data: userData } = await supabase.auth.getUser();
    return userData.user ?? null;
  };

  const setPanelState = (user) => {
    if (!signedOut || !signedIn || !avatar || !name || !email) return;

    if (!user) {
      signedOut.hidden = false;
      signedIn.hidden = true;
      return;
    }

    const displayName = getUserDisplayName(user);
    const avatarUrl = getUserAvatar(user);
    signedOut.hidden = true;
    signedIn.hidden = false;
    currentUser = user;
    name.textContent = displayName;
    email.textContent = user.email ?? "";
    avatar.src = avatarUrl || getFallbackAvatar(displayName);

    const hasCustomAvatar = Boolean(user.user_metadata?.custom_avatar);
    if (avatarResetButton) avatarResetButton.hidden = !hasCustomAvatar;
    if (avatarHint) avatarHint.hidden = false;
  };

  if (!isSupabaseConfigured || !supabase) {
    if (configMissing) configMissing.hidden = false;
    setMessage("配置完成后，这里会显示第三方和邮箱登录状态。");
  } else {
    const redirectTo = getRedirectTo();
    setPanelState(await getCurrentUser());

    supabase.auth.onAuthStateChange((_event, session) => {
      setPanelState(session?.user ?? null);
    });

    panel?.querySelectorAll("[data-oauth-provider]").forEach((button) => {
      button.addEventListener("click", async () => {
        const provider = button.getAttribute("data-oauth-provider");
        setMessage("正在跳转到登录服务...");
        const { error } = await supabase.auth.signInWithOAuth({
          provider,
          options: { redirectTo },
        });

        if (error) setMessage(`登录失败：${error.message}`);
      });
    });

    emailForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const targetEmail = normalizeEmail(emailInput?.value);
      if (!targetEmail) return;

      await sendEmailOtp(targetEmail);
    });

    otpForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const targetEmail = normalizeEmail(currentEmail || emailInput?.value);
      const otp = otpInput?.value?.trim();

      if (!targetEmail) {
        setMessage("请先发送验证码。");
        return;
      }
      if (!otp) return;
      if (!/^\d{8}$/.test(otp)) {
        setMessage("请输入 8 位数字验证码。");
        return;
      }

      setVerifying(true);
      setMessage("正在验证验证码...");
      const { data, error } = await supabase.auth.verifyOtp({
        email: targetEmail,
        token: otp,
        type: "email",
      });
      setVerifying(false);

      if (error) {
        setMessage(`验证失败：${error.message}`);
        return;
      }

      setPanelState(data.user ?? data.session?.user ?? (await getCurrentUser()));
      notifyAuthUpdated();
      setMessage("登录成功。");
    });

    resendOtpButton?.addEventListener("click", async () => {
      if (resendSeconds > 0) return;
      const targetEmail = normalizeEmail(currentEmail || emailInput?.value);
      if (!targetEmail) {
        setMessage("请先填写邮箱。");
        return;
      }

      await sendEmailOtp(targetEmail);
    });

    signOutButton?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      setPanelState(null);
      notifyAuthUpdated();
      setMessage("已退出登录。");
    });

    // Avatar upload handling
    const handleAvatarFile = async (file: File | null | undefined) => {
      if (!file || !supabase || !currentUser || !avatar || !avatarProgress) return;
      const allowedTypes = ["image/jpeg", "image/png", "image/webp", "image/gif"];
      if (!allowedTypes.includes(file.type)) {
        setMessage("请选择 JPG、PNG、WebP 或 GIF 格式的图片。");
        return;
      }
      if (file.size > 2 * 1024 * 1024) {
        setMessage("图片大小不能超过 2 MB。");
        return;
      }

      avatarProgress.hidden = false;
      avatarProgress.style.width = "30%";
      setMessage("正在上传头像...");

      try {
        avatarProgress.style.width = "60%";
        const result = await uploadUserAvatar(supabase, currentUser.id, file);
        avatarProgress.style.width = "100%";

        if (result.error) {
          setMessage(`上传失败：${result.error}`);
          return;
        }

        currentUser = await getCurrentUser();
        if (currentUser) {
          avatar.src = getUserAvatar(currentUser) || getFallbackAvatar(getUserDisplayName(currentUser));
          if (avatarResetButton) avatarResetButton.hidden = false;
        }
        notifyAuthUpdated();
        setMessage("头像已更新。");
      } catch (err) {
        setMessage(`上传失败：${err instanceof Error ? err.message : "未知错误"}`);
      } finally {
        setTimeout(() => {
          if (avatarProgress) avatarProgress.hidden = true;
          if (avatarProgress) avatarProgress.style.width = "0%";
        }, 600);
      }
    };

    avatarChangeButton?.addEventListener("click", () => avatarInput?.click());

    avatarInput?.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      const file = target.files?.[0];
      handleAvatarFile(file);
      if (avatarInput) avatarInput.value = "";
    });

    avatarResetButton?.addEventListener("click", async () => {
      if (!supabase || !avatar) return;
      avatarResetButton.disabled = true;
      setMessage("正在恢复默认头像...");
      try {
        await resetUserAvatar(supabase);
        currentUser = await getCurrentUser();
        if (currentUser) {
          const fallbackUrl = getUserOriginalAvatar(currentUser) || getFallbackAvatar(getUserDisplayName(currentUser));
          avatar.src = fallbackUrl;
          avatarResetButton.hidden = true;
        }
        notifyAuthUpdated();
        setMessage("已恢复默认头像。");
      } catch (err) {
        setMessage(`恢复失败：${err instanceof Error ? err.message : "未知错误"}`);
      } finally {
        if (avatarResetButton) avatarResetButton.disabled = false;
      }
    });
  }
</script>

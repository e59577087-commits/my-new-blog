<section class="auth-panel surface rounded-lg p-5 sm:p-6" data-auth-panel>
  <div data-auth-config-missing hidden class="notice-box rounded-md border p-4 text-sm leading-7">
    登录功能尚未配置。请先在 `.env` 中填写 Supabase 项目的 `PUBLIC_SUPABASE_URL` 和 `PUBLIC_SUPABASE_ANON_KEY`。
  </div>

  <div data-auth-signed-out>
    <div>
      <p class="kicker text-sm font-medium">账户登录</p>
      <h2 class="heading-text mt-2 text-2xl font-semibold">登录后同步你的身份状态</h2>
      <p class="body-text mt-3 text-base leading-8">登录后可以保留同一个身份，之后如果再开放互动内容，也能直接继续使用。</p>
    </div>

    <div class="mt-7 grid gap-3 sm:grid-cols-2">
      <button type="button" data-oauth-provider="github" class="provider-button rounded-md border px-4 py-3 text-left text-sm font-medium transition-colors">
        使用 GitHub 登录
      </button>
      <button type="button" data-oauth-provider="google" class="provider-button rounded-md border px-4 py-3 text-left text-sm font-medium transition-colors">
        使用 Google 登录
      </button>
    </div>

    <form data-email-form class="auth-divider mt-7 border-t pt-6">
      <label for="auth-email" class="heading-text text-sm font-medium">邮箱验证码登录</label>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row">
        <input
          id="auth-email"
          data-email-input
          type="email"
          required
          placeholder="name@example.com"
          class="input-control min-w-0 flex-1 rounded-md border px-3 py-2.5 text-sm outline-none transition"
        />
        <button data-send-otp type="submit" class="primary-button rounded-md border px-4 py-2.5 text-sm font-medium transition-colors">
          发送验证码
        </button>
      </div>
    </form>

    <form data-otp-form hidden class="mt-5">
      <label for="auth-otp" class="heading-text text-sm font-medium">6 位验证码</label>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row">
        <input
          id="auth-otp"
          data-otp-input
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          required
          placeholder="000000"
          class="input-control min-w-0 flex-1 rounded-md border px-3 py-2.5 text-sm outline-none transition"
        />
        <button type="submit" class="primary-button rounded-md border px-4 py-2.5 text-sm font-medium transition-colors">
          验证登录
        </button>
      </div>
      <button
        data-resend-otp
        type="button"
        class="secondary-button mt-3 rounded-md border px-4 py-2.5 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-60"
      >
        重新发送验证码
      </button>
    </form>
  </div>

  <div data-auth-signed-in hidden>
    <div class="flex items-start gap-4">
      <img data-panel-avatar alt="用户头像" class="size-14 rounded-lg border hairline object-cover" />
      <div class="min-w-0">
        <p class="kicker text-sm font-medium">已登录</p>
        <h2 data-panel-name class="heading-text mt-1 truncate text-2xl font-semibold"></h2>
        <p data-panel-email class="faint-text mt-1 truncate text-sm"></p>
      </div>
    </div>

    <button type="button" data-panel-signout class="secondary-button mt-6 rounded-md border px-4 py-2.5 text-sm transition-colors">
      退出登录
    </button>
  </div>

  <p data-auth-message class="body-text mt-5 text-sm leading-7" aria-live="polite"></p>
</section>

<script>
  import { createBrowserSupabaseClient, getFallbackAvatar, getUserAvatar, getUserDisplayName, isSupabaseConfigured } from "../lib/supabaseClient";

  const panel = document.querySelector("[data-auth-panel]");
  const configMissing = panel?.querySelector("[data-auth-config-missing]");
  const signedOut = panel?.querySelector("[data-auth-signed-out]");
  const signedIn = panel?.querySelector("[data-auth-signed-in]");
  const message = panel?.querySelector("[data-auth-message]");
  const avatar = panel?.querySelector("[data-panel-avatar]");
  const name = panel?.querySelector("[data-panel-name]");
  const email = panel?.querySelector("[data-panel-email]");
  const signOutButton = panel?.querySelector("[data-panel-signout]");
  const emailForm = panel?.querySelector("[data-email-form]");
  const emailInput = panel?.querySelector("[data-email-input]");
  const sendOtpButton = panel?.querySelector("[data-send-otp]");
  const otpForm = panel?.querySelector("[data-otp-form]");
  const otpInput = panel?.querySelector("[data-otp-input]");
  const resendOtpButton = panel?.querySelector("[data-resend-otp]");
  const supabase = createBrowserSupabaseClient();
  const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/+$/, "");

  const getRedirectTo = () => `${configuredSiteUrl || window.location.origin}/login`;
  let currentEmail = "";
  let resendSeconds = 0;
  let resendTimer;

  const setMessage = (text) => {
    if (message) message.textContent = text;
  };

  const notifyAuthUpdated = () => {
    window.dispatchEvent(new CustomEvent("auth-state-updated"));
  };

  const setSending = (isSending) => {
    if (!sendOtpButton) return;
    sendOtpButton.disabled = isSending;
    sendOtpButton.textContent = isSending ? "正在发送..." : "发送验证码";
  };

  const setVerifying = (isVerifying) => {
    const verifyButton = otpForm?.querySelector("button[type='submit']");
    if (!verifyButton) return;
    verifyButton.disabled = isVerifying;
    verifyButton.textContent = isVerifying ? "正在验证..." : "验证登录";
  };

  const updateResendButton = () => {
    if (!resendOtpButton) return;
    resendOtpButton.disabled = resendSeconds > 0;
    resendOtpButton.textContent = resendSeconds > 0 ? `${resendSeconds} 秒后重新发送` : "重新发送验证码";
  };

  const startResendCountdown = () => {
    window.clearInterval(resendTimer);
    resendSeconds = 60;
    updateResendButton();

    resendTimer = window.setInterval(() => {
      resendSeconds -= 1;
      updateResendButton();

      if (resendSeconds <= 0) {
        window.clearInterval(resendTimer);
      }
    }, 1000);
  };

  const showOtpForm = () => {
    if (!otpForm) return;
    otpForm.hidden = false;
    otpInput?.focus();
  };

  const sendEmailOtp = async (targetEmail) => {
    if (!supabase || !targetEmail) return false;

    setSending(true);
    setMessage("正在发送邮箱验证码...");
    const { error } = await supabase.auth.signInWithOtp({
      email: targetEmail,
    });
    setSending(false);

    if (error) {
      setMessage(`发送失败：${error.message}`);
      return false;
    }

    currentEmail = targetEmail;
    showOtpForm();
    startResendCountdown();
    setMessage("验证码已发送，请检查邮箱。");
    return true;
  };

  const getCurrentUser = async () => {
    if (!supabase) return null;

    const { data: sessionData } = await supabase.auth.getSession();
    if (sessionData.session?.user) return sessionData.session.user;

    const { data: userData } = await supabase.auth.getUser();
    return userData.user ?? null;
  };

  const setPanelState = (user) => {
    if (!signedOut || !signedIn || !avatar || !name || !email) return;

    if (!user) {
      signedOut.hidden = false;
      signedIn.hidden = true;
      return;
    }

    const displayName = getUserDisplayName(user);
    const avatarUrl = getUserAvatar(user);
    signedOut.hidden = true;
    signedIn.hidden = false;
    name.textContent = displayName;
    email.textContent = user.email ?? "";
    avatar.src = avatarUrl || getFallbackAvatar(displayName);
  };

  if (!isSupabaseConfigured || !supabase) {
    if (configMissing) configMissing.hidden = false;
    setMessage("配置完成后，这里会显示第三方和邮箱登录状态。");
  } else {
    const redirectTo = getRedirectTo();
    setPanelState(await getCurrentUser());

    supabase.auth.onAuthStateChange((_event, session) => {
      setPanelState(session?.user ?? null);
    });

    panel?.querySelectorAll("[data-oauth-provider]").forEach((button) => {
      button.addEventListener("click", async () => {
        const provider = button.getAttribute("data-oauth-provider");
        setMessage("正在跳转到登录服务...");
        const { error } = await supabase.auth.signInWithOAuth({
          provider,
          options: { redirectTo },
        });

        if (error) setMessage(`登录失败：${error.message}`);
      });
    });

    emailForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const targetEmail = emailInput?.value?.trim();
      if (!targetEmail) return;

      await sendEmailOtp(targetEmail);
    });

    otpForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const targetEmail = currentEmail || emailInput?.value?.trim();
      const otp = otpInput?.value?.trim();

      if (!targetEmail || !otp) return;
      if (!/^\d{6}$/.test(otp)) {
        setMessage("请输入 6 位数字验证码。");
        return;
      }

      setVerifying(true);
      setMessage("正在验证验证码...");
      const { data, error } = await supabase.auth.verifyOtp({
        email: targetEmail,
        token: otp,
        type: "email",
      });
      setVerifying(false);

      if (error) {
        setMessage(`验证失败：${error.message}`);
        return;
      }

      setPanelState(data.user ?? data.session?.user ?? (await getCurrentUser()));
      notifyAuthUpdated();
      setMessage("登录成功。");
    });

    resendOtpButton?.addEventListener("click", async () => {
      if (resendSeconds > 0) return;
      const targetEmail = currentEmail || emailInput?.value?.trim();
      if (!targetEmail) {
        setMessage("请先填写邮箱。");
        return;
      }

      await sendEmailOtp(targetEmail);
    });

    signOutButton?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      setPanelState(null);
      notifyAuthUpdated();
      setMessage("已退出登录。");
    });
  }
</script>

---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="mb-3 text-sm font-medium text-sky-300/90">{eyebrow}</p>}
  <h1 class="text-balance text-3xl font-semibold leading-tight text-white sm:text-4xl">{title}</h1>
  {description && <p class="mt-4 text-base leading-8 text-slate-400 sm:text-[17px]">{description}</p>}
</div>

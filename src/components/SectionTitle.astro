---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="kicker mb-3 text-sm font-medium">{eyebrow}</p>}
  <h1 class="heading-text text-balance text-3xl font-semibold leading-tight sm:text-4xl">{title}</h1>
  {description && <p class="body-text mt-4 text-base leading-8 sm:text-[17px]">{description}</p>}
</div>

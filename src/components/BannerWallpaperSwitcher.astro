<div
  class="banner-wallpaper-switcher"
  data-html2canvas-ignore="true"
  data-black-hole-click-exempt
>
  <button
    type="button"
    data-banner-wallpaper-switch
    aria-label="更换横幅壁纸"
    aria-busy="false"
  >
    <span class="banner-wallpaper-switcher__surface">
      <svg data-wallpaper-cycle-icon aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none">
        <defs>
          <linearGradient id="wallpaper-cycle-glass-gradient" x1="3" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#fff" stop-opacity="0.92" />
            <stop offset="0.5" stop-color="#dff7ff" stop-opacity="0.46" />
            <stop offset="1" stop-color="#fff" stop-opacity="0.78" />
          </linearGradient>
        </defs>
        <g stroke="url(#wallpaper-cycle-glass-gradient)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 0 0-15.2-6.5L3 8" />
          <path d="M3 3v5h5" />
          <path d="M3 12a9 9 0 0 0 15.2 6.5L21 16" />
          <path d="M16 16h5v5" />
        </g>
      </svg>
    </span>
  </button>
  <span class="sr-only" data-wallpaper-status aria-live="polite"></span>
</div>

<style>
  .banner-wallpaper-switcher {
    position: absolute;
    left: max(0.75rem, env(safe-area-inset-left));
    bottom: 0.75rem;
    z-index: 7;
  }

  .banner-wallpaper-switcher button {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.96);
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }

  .banner-wallpaper-switcher__surface {
    box-sizing: border-box;
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .banner-wallpaper-switcher button:hover .banner-wallpaper-switcher__surface svg {
    opacity: 1;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.32)) brightness(1.12);
  }

  .banner-wallpaper-switcher button:active .banner-wallpaper-switcher__surface svg {
    opacity: 0.68;
  }

  .banner-wallpaper-switcher button:focus-visible {
    outline: none;
  }

  .banner-wallpaper-switcher button:focus-visible .banner-wallpaper-switcher__surface {
    outline: 2px solid rgba(255, 255, 255, 0.92);
    outline-offset: 2px;
  }

  .banner-wallpaper-switcher button:disabled {
    cursor: wait;
  }

  .banner-wallpaper-switcher button:disabled .banner-wallpaper-switcher__surface svg {
    opacity: 0.48;
  }

  .banner-wallpaper-switcher__surface svg {
    flex: 0 0 auto;
    opacity: 0.86;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3));
    transition:
      opacity var(--motion-duration-fast) var(--motion-ease-standard),
      filter var(--motion-duration-fast) var(--motion-ease-standard);
  }

  :global(:root[data-wallpaper-mode="solid"]) .banner-wallpaper-switcher {
    display: none;
  }

  @media (pointer: coarse) {
    .banner-wallpaper-switcher button {
      width: 2.75rem;
      height: 2.75rem;
      place-items: end start;
    }
  }

  @media (max-width: 639px) {
    .banner-wallpaper-switcher {
      left: max(0.5rem, env(safe-area-inset-left));
      bottom: 0.5rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .banner-wallpaper-switcher__surface svg {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const appearance = window.__blogAppearance;
    const button = document.querySelector("[data-banner-wallpaper-switch]");
    if (!appearance || !(button instanceof HTMLButtonElement)) return;

    const status = document.querySelector("[data-wallpaper-status]");
    const wallpaperIds = ["summer", "salvation"];
    const wallpaperNames = {
      summer: "夏日",
      salvation: "Salvation",
    };

    const sourceFor = (wallpaperId) => {
      if (wallpaperId === "salvation") return "/media/wallpaper-salvation-4k-v1.webp";
      if (window.matchMedia("(min-width: 90rem)").matches) return "/media/wallpaper-summer-2560-v1.webp";
      if (window.matchMedia("(min-width: 64rem)").matches) return "/media/wallpaper-summer-1920-v1.webp";
      return "/media/wallpaper-summer-960-v1.webp";
    };

    const syncButton = (wallpaperId) => {
      const name = wallpaperNames[wallpaperId] || wallpaperNames.summer;
      button.dataset.wallpaperId = wallpaperId;
      button.setAttribute("aria-label", `更换横幅壁纸，当前：${name}`);
    };

    const loadWallpaper = async (url) => {
      const image = new Image();
      image.decoding = "async";
      image.src = url;
      await image.decode();
    };

    syncButton(appearance.read().wallpaperId);

    button.addEventListener("click", async (event) => {
      event.stopPropagation();
      if (button.disabled) return;

      const currentId = appearance.read().wallpaperId;
      const currentIndex = Math.max(0, wallpaperIds.indexOf(currentId));
      const nextId = wallpaperIds[(currentIndex + 1) % wallpaperIds.length];
      const nextName = wallpaperNames[nextId];

      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      if (status) status.textContent = `正在加载${nextName}壁纸`;

      try {
        await loadWallpaper(sourceFor(nextId));
        const settings = appearance.apply({ ...appearance.read(), wallpaperId: nextId });
        try {
          window.localStorage.setItem(appearance.storageKey, JSON.stringify(settings));
        } catch {
          // The visual change still works when storage is unavailable.
        }

        syncButton(nextId);
        if (status) status.textContent = `已切换为${nextName}壁纸`;
        window.dispatchEvent(new CustomEvent("blog:appearance-change", { detail: settings }));
        window.requestAnimationFrame(() => {
          window.dispatchEvent(new CustomEvent("blog:wallpaper-change", { detail: { wallpaperId: nextId } }));
        });
      } catch (error) {
        console.warn("Wallpaper failed to load", error);
        if (status) status.textContent = "壁纸加载失败，请重试";
      } finally {
        button.disabled = false;
        button.setAttribute("aria-busy", "false");
      }
    });
  })();
</script>

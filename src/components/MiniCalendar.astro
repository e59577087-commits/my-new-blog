<div class="mini-calendar surface-soft rounded-lg p-4" data-mini-calendar aria-label="迷你日历">
  <!-- Month header -->
  <div class="cal-header">
    <button type="button" class="cal-nav-btn" data-cal-prev aria-label="上个月">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
    <span class="cal-month-year heading-text text-sm font-semibold" data-cal-label></span>
    <button type="button" class="cal-nav-btn" data-cal-next aria-label="下个月">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>

  <!-- Weekday headers + day cells in a single grid for perfect column alignment -->
  <div class="cal-grid" data-cal-grid>
    <span class="cal-weekday">日</span>
    <span class="cal-weekday">一</span>
    <span class="cal-weekday">二</span>
    <span class="cal-weekday">三</span>
    <span class="cal-weekday">四</span>
    <span class="cal-weekday">五</span>
    <span class="cal-weekday">六</span>
  </div>
</div>

<style>
  .mini-calendar {
    --cal-cell-size: 1.55rem;
    user-select: none;
  }

  .cal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
  }

  .cal-nav-btn {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    background: var(--color-field);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .cal-nav-btn:hover {
    border-color: var(--color-accent-border);
    color: var(--color-heading);
    background: var(--color-surface-hover);
  }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, var(--cal-cell-size));
    justify-content: center;
    column-gap: 0.18rem;
    row-gap: 0.08rem;
  }

  .cal-weekday {
    display: grid;
    width: var(--cal-cell-size);
    height: 1rem;
    place-items: center;
    font-size: 0.68rem;
    color: var(--color-faint);
    text-align: center;
    line-height: 1;
    padding-bottom: 0.2rem;
  }

  :global(.cal-day) {
    position: relative;
    isolation: isolate;
    display: grid;
    width: var(--cal-cell-size);
    height: var(--cal-cell-size);
    place-items: center;
    border-radius: 0.38rem;
    font-size: 0.69rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    text-align: center;
    line-height: 1;
    cursor: default;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  :global(.cal-day-number) {
    position: relative;
    z-index: 1;
    transform: translateX(0.04rem);
  }

  :global(.cal-day:hover) {
    background: var(--color-field);
  }

  :global(.cal-day[data-today]) {
    color: #78350f;
    font-weight: 700;
  }

  :global(.cal-day[data-today]::before) {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: inherit;
    background: hsl(42, 96%, 62%);
    box-shadow:
      0 0 0 1px hsl(36 82% 43% / 0.34),
      0 4px 10px hsl(38 85% 44% / 0.22);
    z-index: 0;
  }

  :global(:root[data-theme="dark"] .cal-day[data-today]) {
    color: #fff7ed;
  }

  :global(:root[data-theme="dark"] .cal-day[data-today]::before) {
    background: hsl(38, 84%, 42%);
    box-shadow:
      0 0 0 1px hsl(38 92% 64% / 0.38),
      0 4px 12px hsl(38 85% 35% / 0.34);
  }

  @media (prefers-reduced-motion: reduce) {
    .cal-nav-btn,
    :global(.cal-day) {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  (function miniCalendar() {
    const root = document.querySelector("[data-mini-calendar]");
    if (!root) return;

    const label = root.querySelector("[data-cal-label]");
    const grid = root.querySelector("[data-cal-grid]");
    const prevBtn = root.querySelector("[data-cal-prev]");
    const nextBtn = root.querySelector("[data-cal-next]");

    if (!label || !grid || !prevBtn || !nextBtn) return;

    const today = new Date();
    const todayKey = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;

    let currentYear = today.getFullYear();
    let currentMonth = today.getMonth(); // 0-indexed

    const formatLabel = (year, month) => `${year} 年 ${month + 1} 月`;

    function render() {
      label.textContent = formatLabel(currentYear, currentMonth);

      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

      // Keep weekday headers (first 7 children), remove only day cells
      while (grid.children.length > 7) {
        grid.removeChild(grid.lastChild);
      }

      // Leading blanks
      for (let i = 0; i < firstDay; i++) {
        const cell = document.createElement("span");
        cell.className = "cal-day";
        cell.setAttribute("aria-hidden", "true");
        grid.appendChild(cell);
      }

      // Current month days
      for (let d = 1; d <= daysInMonth; d++) {
        const cell = document.createElement("span");
        cell.className = "cal-day";
        const number = document.createElement("span");
        number.className = "cal-day-number";
        number.textContent = String(d);
        cell.append(number);
        const key = `${currentYear}-${String(currentMonth + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
        if (key === todayKey) {
          cell.setAttribute("data-today", "");
          cell.setAttribute("aria-label", `${d} 日，今天`);
        }
        grid.appendChild(cell);
      }
    }

    function goPrev() {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      render();
    }

    function goNext() {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      render();
    }

    prevBtn.addEventListener("click", goPrev);
    nextBtn.addEventListener("click", goNext);

    // Keyboard navigation
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); goPrev(); }
      if (e.key === "ArrowRight") { e.preventDefault(); goNext(); }
    });

    render();
  })();
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntryUrl, getPublishedArticles, getSectionLabel } from "../utils/articles";

const articles = await getPublishedArticles();
const now = new Date();
const currentYear = now.getFullYear();
const startOfYear = new Date(currentYear, 0, 1);
const startOfNextYear = new Date(currentYear + 1, 0, 1);
const startOfToday = new Date(currentYear, now.getMonth(), now.getDate());
const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / 86_400_000) + 1;
const yearProgress = Math.min(100, ((now.getTime() - startOfYear.getTime()) / (startOfNextYear.getTime() - startOfYear.getTime())) * 100);
const todayProgress = Math.min(100, ((now.getTime() - startOfToday.getTime()) / 86_400_000) * 100);

const monthNames = [
  ["一月", "JAN"],
  ["二月", "FEB"],
  ["三月", "MAR"],
  ["四月", "APR"],
  ["五月", "MAY"],
  ["六月", "JUN"],
  ["七月", "JUL"],
  ["八月", "AUG"],
  ["九月", "SEP"],
  ["十月", "OCT"],
  ["十一月", "NOV"],
  ["十二月", "DEC"],
] as const;

const groupedByYear = new Map<number, Map<number, typeof articles>>();

for (const article of articles) {
  const year = article.data.date.getFullYear();
  const month = article.data.date.getMonth();
  const months = groupedByYear.get(year) ?? new Map<number, typeof articles>();
  const entries = months.get(month) ?? [];
  entries.push(article);
  months.set(month, entries);
  groupedByYear.set(year, months);
}

const yearGroups = Array.from(groupedByYear, ([year, months]) => ({
  year,
  count: Array.from(months.values()).reduce((total, entries) => total + entries.length, 0),
  months: Array.from(months, ([month, entries]) => ({ month, entries })).sort((a, b) => b.month - a.month),
})).sort((a, b) => b.year - a.year);
---

<BaseLayout title="时间线" description="沿着年月，翻阅本站全部已发布内容。">
  <section class="full-timeline mx-auto max-w-6xl px-4 sm:px-6 lg:px-8" data-full-timeline aria-labelledby="timeline-title">
    <header class="timeline-overview">
      <p class="timeline-kicker" id="timeline-title">时间线</p>
      <p class="timeline-total">
        <strong>{articles.length}</strong>
        <span>篇，再接再厉</span>
      </p>

      <dl class="timeline-stats" aria-label="时间进度">
        <div>
          <dd class="is-accent">{dayOfYear}</dd>
          <dt>今年第几天</dt>
        </div>
        <div>
          <dd>{yearProgress.toFixed(0)}<small>%</small></dd>
          <dt>年度进度</dt>
        </div>
        <div>
          <dd>{todayProgress.toFixed(2)}<small>%</small></dd>
          <dt>今日进度</dt>
        </div>
      </dl>

      <p class="timeline-motto">活在当下，珍惜眼下</p>
    </header>

    {
      yearGroups.length > 0 ? (
        <div class="timeline-years">
          {yearGroups.map((group) => (
            <section class="timeline-year" data-timeline-year aria-labelledby={`timeline-year-${group.year}`}>
              <header class="timeline-year-heading">
                <h2 id={`timeline-year-${group.year}`}>{group.year}</h2>
                <p>本年 {group.count} 篇</p>
              </header>

              {group.months.map(({ month, entries }) => {
                const [monthLabel, monthCode] = monthNames[month];
                return (
                  <section class="timeline-month" aria-labelledby={`timeline-month-${group.year}-${month + 1}`}>
                    <h3 id={`timeline-month-${group.year}-${month + 1}`}>
                      {monthLabel} <span aria-hidden="true">·</span> <span>{monthCode}</span>
                    </h3>
                    <ol>
                      {entries.map((article) => (
                        <li data-timeline-entry>
                          <time datetime={article.data.date.toISOString()}>{String(article.data.date.getDate()).padStart(2, "0")}</time>
                          <a href={getEntryUrl(article)} data-article-transition>
                            {article.data.title}
                          </a>
                          <p>
                            {article.data.pinned && <span class="timeline-pin" aria-label="置顶">◆</span>}
                            <span>{getSectionLabel(article)}</span>
                            {article.data.tags.length > 0 && <span> · {article.data.tags.join(" · ")}</span>}
                          </p>
                        </li>
                      ))}
                    </ol>
                  </section>
                );
              })}
            </section>
          ))}
        </div>
      ) : (
        <p class="timeline-empty">时间线上还没有文章，第一篇正在路上。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .full-timeline {
    padding-block: clamp(3.75rem, 8vw, 6.5rem) clamp(6rem, 10vw, 9rem);
  }

  .timeline-overview {
    max-width: 62rem;
  }

  .timeline-kicker {
    color: var(--color-heading);
    font-family: var(--font-wenkai);
    font-size: 1rem;
    letter-spacing: 0.16em;
  }

  .timeline-total {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-top: 0.9rem;
    color: var(--color-heading);
  }

  .timeline-total strong {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 9vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .timeline-total span {
    font-size: 1rem;
  }

  .timeline-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.7rem, 5vw, 3.4rem);
    margin-top: 2rem;
  }

  .timeline-stats div {
    display: grid;
    gap: 0.15rem;
  }

  .timeline-stats dd {
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 4vw, 2.2rem);
    line-height: 1.1;
  }

  .timeline-stats dd.is-accent {
    color: var(--color-accent-text);
  }

  .timeline-stats small {
    margin-left: 0.15rem;
    font-size: 0.75rem;
  }

  .timeline-stats dt,
  .timeline-motto {
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .timeline-motto {
    margin-top: 1.45rem;
  }

  .timeline-years {
    display: grid;
    gap: 5rem;
    margin-top: clamp(3.5rem, 8vw, 6.2rem);
  }

  .timeline-year-heading {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .timeline-year-heading h2 {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .timeline-year-heading p {
    color: var(--color-faint);
    font-size: 0.78rem;
  }

  .timeline-month {
    margin-top: 1.85rem;
  }

  .timeline-month h3 {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .timeline-month ol {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.65rem;
  }

  .timeline-month li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) minmax(10rem, 19rem);
    align-items: baseline;
    column-gap: 1rem;
    border-radius: 0.65rem;
    padding: 0.62rem 0.7rem 0.62rem 0;
    transition:
      background-color var(--motion-duration-fast) ease,
      transform var(--motion-duration-fast) var(--motion-ease-enter);
  }

  .timeline-month li:hover {
    background: var(--color-surface-hover);
    transform: translateX(0.25rem);
  }

  .timeline-month time {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: right;
  }

  .timeline-month a {
    color: var(--color-heading);
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    font-weight: 550;
    line-height: 1.55;
    text-decoration: none;
    transition: color var(--motion-duration-fast) ease;
  }

  .timeline-month a:hover,
  .timeline-month a:focus-visible {
    color: var(--color-accent-text);
  }

  .timeline-month a:focus-visible {
    border-radius: 0.2rem;
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .timeline-month li > p {
    overflow: hidden;
    color: var(--color-faint);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline-pin {
    margin-right: 0.45rem;
    color: var(--color-accent-text);
    font-size: 0.55rem;
  }

  .timeline-empty {
    margin-top: 4rem;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .timeline-years {
      gap: 3.5rem;
    }

    .timeline-month li {
      grid-template-columns: 2rem minmax(0, 1fr);
      column-gap: 0.75rem;
      padding-block: 0.72rem;
    }

    .timeline-month li > p {
      grid-column: 2;
      margin-top: 0.15rem;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-month li {
      transition: none;
    }

    .timeline-month li:hover {
      transform: none;
    }
  }
</style>

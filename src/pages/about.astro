---
import SectionTitle from "../components/SectionTitle.astro";
import StatsCard from "../components/StatsCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { shareItems } from "../data/share";
import { tools } from "../data/tools";

const articleCount = tools.length + shareItems.length;
---

<BaseLayout title="关于" description="关于 happy,for you 这个个人小站。">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <SectionTitle
      title="关于这个小站"
    />

    <StatsCard articleCount={articleCount} />

    <div class="mt-10">
    </div>
  </section>
</BaseLayout>

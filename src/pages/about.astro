---
import AboutRainWindow from "../components/AboutRainWindow.astro";
import AboutGlassClock from "../components/AboutGlassClock.astro";
import StatsCard from "../components/StatsCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedArticles } from "../utils/articles";
import { countArticlesWords } from "../utils/articleWordCount";

const articles = await getPublishedArticles();
const articleCount = articles.length;
const totalWordCount = countArticlesWords(articles);
---

<BaseLayout title="关于" description="关于 haven,for you 这个个人小站。">
  <section class="about-rain" data-about-rain-window aria-label="站点统计">
    <AboutRainWindow />
    <AboutGlassClock />
    <div class="about-rain__stats" data-about-stats-overlay>
      <StatsCard articleCount={articleCount} totalWordCount={totalWordCount} variant="overlay" />
    </div>
  </section>
</BaseLayout>

<style>
  .about-rain {
    position: relative;
    min-height: 100svh;
    margin-top: calc(var(--site-header-height) * -1);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-page);
  }

  .about-rain__stats {
    position: absolute;
    z-index: 10;
    right: clamp(1rem, 4vw, 4rem);
    bottom: clamp(1.25rem, 5vh, 3.75rem);
    width: min(34rem, calc(100% - 2rem));
    opacity: 0;
    transform: translateY(0.8rem);
    transition:
      opacity 560ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-stats-ready="true"] .about-rain__stats {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .about-rain__stats {
      right: 1rem;
      bottom: max(1rem, env(safe-area-inset-bottom));
      left: 1rem;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-rain__stats {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initAboutStatsReveal() {
    const windowReadyEvent = "about-window-ready";
    const statsReadyClass = "about-stats-ready";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll("[data-about-rain-window]:not([data-about-mounted])").forEach((page) => {
      if (!(page instanceof HTMLElement)) return;
      page.dataset.aboutMounted = "true";

      const revealStats = () => {
        page.dataset.statsReady = "true";
        page.classList.add(statsReadyClass);
      };

      if (reduceMotion) {
        revealStats();
        return;
      }

      page.addEventListener(windowReadyEvent, revealStats, { once: true });
      window.setTimeout(revealStats, 2600);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutStatsReveal, { once: true });
  } else {
    initAboutStatsReveal();
  }

  document.addEventListener("astro:after-swap", initAboutStatsReveal);
</script>

---
import SectionTitle from "../components/SectionTitle.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools } from "../data/tools";
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = Array.from(new Set(tools.map((tool) => tool.category)));
---

<BaseLayout title="软件分享" description="面向独立开发者和技术写作者的软件工具导航。">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_280px] lg:items-end">
      <SectionTitle
        eyebrow="软件分享"
        title="独立开发者工具导航"
        description="收集适合写作、构建、设计和部署的高质量软件。只保留必要信息：用途、分类、官网、GitHub 与下载入口。"
      />

      <aside class="surface rounded-lg p-5">
        <p class="text-sm text-slate-500">当前分类</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {categories.map((category) => <span class="rounded border hairline bg-[#0f1115] px-2.5 py-1 text-xs text-slate-300">{category}</span>)}
        </div>
      </aside>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</BaseLayout>

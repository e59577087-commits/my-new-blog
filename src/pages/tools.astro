---
import ToolCard from "../components/ToolCard.astro";
import { tools } from "../data/tools";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="随笔" description="一些最近常出现在生活里的小东西。">
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header>
      <div>
        <h1 class="heading-text text-3xl font-semibold leading-tight sm:text-4xl">随笔</h1>
      </div>
    </header>

    <div class="mt-6" data-appearance-article-list="catalog">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryCard from "../components/EntryCard.astro";
import { getPublishedBySection } from "../utils/articles";

const shares = await getPublishedBySection("share");
---

<BaseLayout title="分享" description="分享一些想记录的东西。">
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header>
      <div>
        <h1 class="heading-text text-3xl font-semibold leading-tight sm:text-4xl">分享</h1>
      </div>
    </header>

    <div class="mt-6" data-appearance-article-list="catalog">
      {shares.map((entry) => <EntryCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

---
import SectionTitle from "../components/SectionTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="分享" description="分享这个个人小站的入口。">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <SectionTitle title="分享" description="几个可以直接打开的站内入口。" />

    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      <article class="surface-soft rounded-lg p-4">
        <p class="text-xs text-sky-300/80">入口</p>
        <h2 class="mt-1 text-lg font-semibold text-white">首页</h2>
        <a href="/" class="mt-4 inline-flex rounded border hairline px-3 py-1.5 text-sm text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
          打开
        </a>
      </article>

      <article class="surface-soft rounded-lg p-4">
        <p class="text-xs text-sky-300/80">入口</p>
        <h2 class="mt-1 text-lg font-semibold text-white">日常</h2>
        <a href="/tools/" class="mt-4 inline-flex rounded border hairline px-3 py-1.5 text-sm text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
          打开
        </a>
      </article>

      <article class="surface-soft rounded-lg p-4">
        <p class="text-xs text-sky-300/80">入口</p>
        <h2 class="mt-1 text-lg font-semibold text-white">关于</h2>
        <a href="/about/" class="mt-4 inline-flex rounded border hairline px-3 py-1.5 text-sm text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
          打开
        </a>
      </article>
    </div>
  </section>
</BaseLayout>

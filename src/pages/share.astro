---
import BaseLayout from "../layouts/BaseLayout.astro";
import { shareItems } from "../data/share";
---

<BaseLayout title="分享" description="分享一些想记录的东西。">
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header>
      <div>
        <h1 class="heading-text text-3xl font-semibold leading-tight sm:text-4xl">分享</h1>
        <p class="muted mt-2">一些想记录和分享的东西。</p>
      </div>
    </header>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {shareItems.map((item) => (
        <a href={`/share/${item.slug}/`} class="surface-soft motion-card flex rounded-lg overflow-hidden" aria-label={`打开${item.title}`}>
            <img src={item.screenshot} alt="" loading="lazy" class="w-24 shrink-0 object-cover sm:w-32" />
            <div class="min-w-0 flex flex-col justify-center p-4">
              <p class="kicker text-xs">{item.category}</p>
              <h2 class="heading-text mt-1 truncate text-xl font-semibold leading-7">{item.title}</h2>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {item.tags.map((tag) => <span class="rounded bg-[var(--color-field)] px-2 py-0.5 text-xs muted">{tag}</span>)}
              </div>
            </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

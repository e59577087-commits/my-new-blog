---
import BaseLayout from "../layouts/BaseLayout.astro";
import { shareItems } from "../data/share";
---

<BaseLayout title="分享" description="分享一些想记录的东西。">
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header>
      <div>
        <h1 class="text-3xl font-semibold leading-tight text-white sm:text-4xl">分享</h1>
        <p class="mt-2 text-slate-400">一些想记录和分享的东西。</p>
      </div>
    </header>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {shareItems.map((item) => (
        <a href={`/share/${item.slug}/`} class="surface-soft motion-card block rounded-lg p-4 sm:p-5" aria-label={`打开${item.title}`}>
          <div class="flex items-center gap-4">
            <img src={item.screenshot} alt="" loading="lazy" class="size-16 shrink-0 rounded-md border hairline object-cover sm:size-20" />
            <div class="min-w-0">
              <p class="text-xs text-sky-300/80">{item.category}</p>
              <h2 class="mt-1 truncate text-xl font-semibold leading-7 text-white">{item.title}</h2>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {item.tags.map((tag) => <span class="rounded bg-[#0f1115] px-2 py-0.5 text-xs text-slate-400">{tag}</span>)}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

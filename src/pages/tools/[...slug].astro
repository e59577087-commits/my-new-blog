---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tools, type Tool } from "../../data/tools";

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props as { tool: Tool };
---

<BaseLayout title={tool.name} description={tool.description}>
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <a href="/tools/" class="fine-link text-sm">返回日常</a>

    <header class="mt-8">
      <p class="kicker text-xs">{tool.category}</p>
      <h1 class="heading-text mt-2 text-3xl font-semibold leading-tight sm:text-5xl">{tool.name}</h1>

      <div class="mt-5 flex flex-wrap gap-2">
        {tool.tags.map((tag) => <span class="rounded border hairline bg-[var(--color-surface-solid)] px-2.5 py-1 text-xs muted">{tag}</span>)}
      </div>

      <img src={tool.screenshot} alt="" class="mt-8 aspect-[16/8] w-full rounded-lg border hairline object-cover" />
    </header>

    <div class="mt-10 max-w-3xl">
      <p class="text-body text-lg leading-relaxed">{tool.description}</p>
    </div>

    {
      tool.links.length > 0 && (
        <nav class="mt-10 flex flex-wrap gap-3">
          {tool.links.map((link) => (
            <a href={link.href} class="rounded-lg border hairline bg-[var(--color-surface-solid)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-heading)]">{link.label}</a>
          ))}
        </nav>
      )
    }
  </article>
</BaseLayout>

---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticleSlug, getPublishedBySection } from "../../utils/articles";

export async function getStaticPaths() {
  const articles = await getPublishedBySection("essay");

  return articles.map((article, index) => {
    const prev = index < articles.length - 1 ? articles[index + 1] : null;
    const next = index > 0 ? articles[index - 1] : null;
    return {
      params: { slug: getArticleSlug(article) },
      props: { article, prev, next },
    };
  });
}

const { article, prev, next } = Astro.props;
---

<ArticleLayout article={article} prev={prev} next={next} backHref="/tools/" backLabel="返回随笔" />

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shareItems, type ShareItem } from "../../data/share";

export function getStaticPaths() {
  return shareItems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: ShareItem };
---

<BaseLayout title={item.title} description={item.description}>
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <a href="/share/" class="fine-link text-sm">返回分享</a>

    <header class="mt-8 border-b hairline pb-8">
      <p class="kicker text-xs">{item.category}</p>
      <h1 class="heading-text mt-2 text-3xl font-semibold leading-tight sm:text-5xl">{item.title}</h1>
      <time datetime={item.date} class="faint-text mt-3 block text-sm">{item.date}</time>

      <div class="mt-5 flex flex-wrap gap-2">
        {item.tags.map((tag) => <span class="rounded border hairline bg-[var(--color-surface-solid)] px-2.5 py-1 text-xs muted">{tag}</span>)}
      </div>

      <img src={item.screenshot} alt="" class="mt-8 aspect-[16/8] w-full rounded-lg border hairline object-cover" />
    </header>

    <div class="prose-tech mt-10 max-w-3xl space-y-6">
      <p class="text-body text-lg leading-relaxed">{item.description}</p>
      <div class="text-body mt-8 leading-relaxed whitespace-pre-line">{item.content}</div>
    </div>

    {
      item.links.length > 0 && (
        <nav class="mt-10 flex flex-wrap gap-3">
          {item.links.map((link) => (
            <a href={link.href} class="rounded-lg border hairline bg-[var(--color-surface-solid)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-heading)]">{link.label}</a>
          ))}
        </nav>
      )
    }
  </article>
</BaseLayout>

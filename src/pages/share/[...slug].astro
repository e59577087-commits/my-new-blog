---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shareItems, type ShareItem } from "../../data/share";

export function getStaticPaths() {
  return shareItems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: ShareItem };
---

<BaseLayout title={item.title} description={item.description}>
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <a href="/share/" class="text-sm text-sky-300/80 hover:text-sky-300 transition-colors">返回分享</a>

    <header class="mt-8 border-b hairline pb-8">
      <p class="text-xs text-sky-300/80">{item.category}</p>
      <h1 class="mt-2 text-3xl font-semibold leading-tight text-white sm:text-5xl">{item.title}</h1>
      <time datetime={item.date} class="mt-3 block text-sm text-slate-500">{item.date}</time>

      <div class="mt-5 flex flex-wrap gap-2">
        {item.tags.map((tag) => <span class="rounded border hairline bg-[#111318] px-2.5 py-1 text-xs text-slate-400">{tag}</span>)}
      </div>

      <img src={item.screenshot} alt="" class="mt-8 aspect-[16/8] w-full rounded-lg border hairline object-cover" />
    </header>

    <div class="prose-tech mt-10 max-w-3xl space-y-6">
      <p class="text-lg leading-relaxed text-slate-300">{item.description}</p>
      <div class="mt-8 text-slate-300 leading-relaxed whitespace-pre-line">{item.content}</div>
    </div>

    {
      item.links.length > 0 && (
        <nav class="mt-10 flex flex-wrap gap-3">
          {item.links.map((link) => (
            <a href={link.href} class="rounded-lg border hairline bg-[#111318] px-5 py-2.5 text-sm font-medium text-slate-200 hover:bg-[#1a1d24] hover:text-white transition-colors">{link.label}</a>
          ))}
        </nav>
      )
    }
  </article>
</BaseLayout>

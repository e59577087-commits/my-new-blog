---
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools } from "../data/tools";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostUrl, getReadingTime, isPublished, sortPostsByDate } from "../utils/blog";

const allPosts = sortPostsByDate((await getCollection("blog")).filter(isPublished));
const posts = allPosts.slice(0, 3);

const featuredPosts = allPosts.filter((post) => post.data.featured);

const recommendedTools = tools.slice(0, 4);
---

<BaseLayout title="首页">
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-14 sm:px-6 sm:pb-16 sm:pt-20 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
      <div class="reveal">
        <p class="mb-5 inline-flex rounded border hairline bg-[#111318] px-3 py-1 text-sm text-sky-200">
          日常记录 · 喜欢的事 · 慢慢生活
        </p>
        <h1 class="text-balance text-4xl font-semibold leading-tight text-white sm:text-5xl">
          把普通日子认真收起来。
        </h1>
        <p class="mt-6 max-w-2xl text-[17px] leading-9 text-slate-400 sm:text-lg">
          这里会放一些日常片段、最近喜欢的东西、偶尔冒出来的想法。页面还是简单清爽，但内容会更像一个真实的人在慢慢生活。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/blog/" class="rounded-md bg-slate-100 px-4 py-2.5 text-sm font-medium text-[#0f1115] transition-colors hover:bg-white">
            看看日记
          </a>
          <a href="/tools/" class="rounded-md border hairline bg-[#111318] px-4 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:border-sky-300/35 hover:text-white">
            翻翻日常
          </a>
        </div>
        <dl class="mt-10 grid max-w-2xl gap-3 text-sm text-slate-400 sm:grid-cols-3">
          <div class="border-l hairline pl-4">
            <dt class="text-slate-500">常写内容</dt>
            <dd class="mt-1 text-slate-200">生活碎片</dd>
          </div>
          <div class="border-l hairline pl-4">
            <dt class="text-slate-500">更新节奏</dt>
            <dd class="mt-1 text-slate-200">想到就写</dd>
          </div>
          <div class="border-l hairline pl-4">
            <dt class="text-slate-500">页面气质</dt>
            <dd class="mt-1 text-slate-200">轻松干净</dd>
          </div>
        </dl>
      </div>

      <aside class="surface reveal reveal-delay-1 rounded-lg p-5 sm:p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm text-sky-200">最近想看</p>
            <h2 class="mt-1 text-xl font-semibold text-white">放在手边的记录</h2>
          </div>
          <span class="rounded border hairline px-2.5 py-1 text-xs text-slate-400">慢慢更新</span>
        </div>

        <div class="mt-6 divide-y divide-white/[0.06]">
          {
            featuredPosts.map((post) => (
              <a href={getPostUrl(post)} class="group block py-4 first:pt-0 last:pb-0">
                <p class="text-base font-medium leading-7 text-slate-100 transition-colors group-hover:text-white">{post.data.title}</p>
                <p class="mt-1 line-clamp-2 text-sm leading-7 text-slate-500">{post.data.description}</p>
              </a>
            ))
          }
        </div>

        <div class="mt-6 border-t hairline pt-5">
          <p class="text-sm text-slate-500">最近关键词</p>
          <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
            {
              ["散步", "做饭", "读书", "整理"].map((item) => (
                <div class="flex items-center gap-2 text-slate-300">
                  <span class="size-1.5 rounded-full bg-sky-300"></span>
                  {item}
                </div>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y hairline bg-[#111318]">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="reveal reveal-delay-2">
        <SectionTitle eyebrow="最近写了" title="这些天留下的小片段" description="不追求特别完整，只把当时的心情、看到的东西和一点点生活变化记下来。" />
      </div>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {
          posts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              cover={post.data.cover}
              readingTime={getReadingTime(post)}
              href={getPostUrl(post)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="reveal reveal-delay-3">
      <SectionTitle eyebrow="日常角落" title="最近常出现在生活里的东西" description="可能是一首歌、一条散步路线，也可能是一个让我觉得顺手的小习惯。" />
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {recommendedTools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</BaseLayout>

---
import ToolCard from "../components/ToolCard.astro";
import ProfileCard from "../components/ProfileCard.astro";
import BannerParticles from "../components/BannerParticles.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { shareItems } from "../data/share";
import { tools } from "../data/tools";
import { formatArticleDate, getArticleUrl, getPublishedArticles } from "../utils/articles";

const articles = await getPublishedArticles();
const toDate = (date: string) => new Date(`${date}T00:00:00`);
const latestItems = [
  ...articles.map((article) => ({
    title: article.data.title,
    href: getArticleUrl(article),
    image: article.data.cover,
    date: article.data.date,
    tags: article.data.tags,
    category: "文章",
    pinned: article.data.pinned,
  })),
  ...tools.map((tool) => ({
    title: tool.name,
    href: `/tools/${tool.slug}/`,
    image: tool.screenshot,
    date: toDate(tool.date),
    tags: tool.tags,
    category: `随笔 / ${tool.category}`,
    pinned: tool.pinned ?? false,
  })),
  ...shareItems.map((item) => ({
    title: item.title,
    href: `/share/${item.slug}/`,
    image: item.screenshot,
    date: toDate(item.date),
    tags: item.tags,
    category: `分享 / ${item.category}`,
    pinned: item.pinned ?? false,
  })),
].sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.date.getTime() - a.date.getTime());
const latest = latestItems[0];
const latestList = latestItems.slice(1, 5);
const previewTools = tools.slice(0, 3);
const previewShares = shareItems.slice(0, 3);
const bannerTitle = "从负数到零，真的绕好大一圈呀";
const bannerTitleChars = Array.from(bannerTitle);
---

<BaseLayout title="首页">
  <section class="mx-auto max-w-6xl px-4 pt-1 pb-10 sm:px-6 sm:pt-3 sm:pb-14 lg:px-8">
    <section class="home-hero-banner mb-8 flex items-end p-5 sm:p-7">
      <BannerParticles />
      <div class="home-banner-copy">
        <h1 class="home-banner-title heading-text mt-2 text-3xl leading-tight sm:text-5xl" aria-label={bannerTitle}>
          {bannerTitleChars.map((char, index) => (
            <span class="home-banner-title-char" style={`--char-delay: ${280 + index * 170}ms`} aria-hidden="true">{char}</span>
          ))}
          <span class="home-banner-cursor" aria-hidden="true"></span>
        </h1>
      </div>
    </section>

    <!-- 最新 -->
    {
      latest && (
    <section class="latest-region">
      <div class="latest-profile-sidecar">
        <ProfileCard />
      </div>

      <section>
        <div class="mb-5 flex items-end justify-between">
          <h2 class="heading-text text-xl font-semibold">最新</h2>
        </div>

      <div class="latest-layout grid gap-5 lg:grid-cols-[minmax(0,2.5fr)_minmax(320px,1.6fr)]">
        <!-- Featured article (large card, left column) -->
        <a href={latest.href} data-reveal class="surface motion-card group block overflow-hidden rounded-lg">
          <img src={latest.image} alt="" loading="eager" decoding="async" fetchpriority="high" width="960" height="621" class="aspect-[16/8] w-full object-cover lg:aspect-[16/7]" />
          <div class="p-5 sm:p-6">
            <div class="flex flex-wrap items-center gap-2">
              <time datetime={latest.date.toISOString()} class="faint-text text-sm">{formatArticleDate(latest.date)}</time>
              {latest.pinned && <span class="rounded bg-[var(--color-accent-soft)] px-2 py-0.5 text-xs kicker">置顶</span>}
              <span class="kicker text-xs">{latest.category}</span>
            </div>
            <h2 class="heading-text mt-3 text-2xl font-semibold leading-8 transition-colors group-hover:text-[var(--color-accent-text)] sm:text-3xl">{latest.title}</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {latest.tags.map((tag) => <span class="rounded bg-[var(--color-field)] px-2.5 py-1 text-xs muted">{tag}</span>)}
            </div>
          </div>
        </a>

        <!-- Article list (3 cards, right column) -->
        <div data-appearance-article-list="compact" data-reveal-stagger>
          {
            latestList.map((item) => (
              <a href={item.href} data-reveal class="surface-soft motion-card flex rounded-lg overflow-hidden">
                <img src={item.image} alt="" loading="lazy" decoding="async" width="320" height="240" class="aspect-[4/3] w-28 shrink-0 object-cover sm:w-40" />
                <div class="min-w-0 flex flex-col justify-center p-4">
                  <div class="flex flex-wrap items-center gap-2">
                    <time datetime={item.date.toISOString()} class="faint-text text-xs">{formatArticleDate(item.date)}</time>
                    {item.pinned && <span class="rounded bg-[var(--color-accent-soft)] px-2 py-0.5 text-xs kicker">置顶</span>}
                    <span class="kicker text-xs">{item.category}</span>
                  </div>
                  <h2 class="heading-text mt-1.5 text-lg font-semibold leading-7">{item.title}</h2>
                  <div class="mt-2.5 flex flex-wrap gap-1.5">
                    {item.tags.map((tag) => <span class="rounded bg-[var(--color-field)] px-2 py-0.5 text-xs muted">{tag}</span>)}
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
      </section>
    </section>
      )
    }

    <!-- Decorative divider -->
    <div class="decorative-divider" aria-hidden="true">
      <svg class="decorative-divider-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 2v4"/>
        <path d="M12 18v4"/>
        <path d="M4.93 4.93l2.83 2.83"/>
        <path d="M16.24 16.24l2.83 2.83"/>
        <path d="M2 12h4"/>
        <path d="M18 12h4"/>
        <path d="M4.93 19.07l2.83-2.83"/>
        <path d="M16.24 7.76l2.83-2.83"/>
      </svg>
    </div>

    <!-- 随笔 -->
    {
      previewTools.length > 0 && (
        <section class="mt-2">
          <div class="mb-5 flex items-end justify-between">
            <div>
              <h2 class="heading-text text-xl font-semibold">随笔</h2>
              <p class="muted mt-1 text-sm">最近常出现在生活里的小东西。</p>
            </div>
            <a href="/tools/" class="fine-link flex items-center gap-1 text-sm">
              查看全部
              <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
              </svg>
            </a>
          </div>
          <div data-appearance-article-list="wide" data-reveal-stagger>
            {previewTools.map((tool) => <ToolCard tool={tool} />)}
          </div>
        </section>
      )
    }

    <!-- Decorative divider -->
    <div class="decorative-divider" aria-hidden="true">
      <svg class="decorative-divider-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 10.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8" />
        <path d="m22 11-8 9" />
        <path d="m14 18 8 2 2-8" />
      </svg>
    </div>

    <!-- 分享 -->
    {
      previewShares.length > 0 && (
        <section class="mt-2">
          <div class="mb-5 flex items-end justify-between">
            <div>
              <h2 class="heading-text text-xl font-semibold">分享</h2>
              <p class="muted mt-1 text-sm">一些想记录和分享的东西。</p>
            </div>
            <a href="/share/" class="fine-link flex items-center gap-1 text-sm">
              查看全部
              <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
              </svg>
            </a>
          </div>
          <div data-appearance-article-list="wide" data-reveal-stagger>
            {previewShares.map((item) => (
              <a href={`/share/${item.slug}/`} data-reveal class="surface-soft motion-card flex rounded-lg overflow-hidden" aria-label={`打开${item.title}`}>
                <img src={item.screenshot} alt="" loading="lazy" decoding="async" width="320" height="240" class="aspect-[4/3] w-24 shrink-0 object-cover sm:w-32" />
                <div class="min-w-0 flex flex-col justify-center p-4">
                  <p class="kicker text-xs">{item.category}</p>
                  <h2 class="heading-text mt-1 truncate text-xl font-semibold leading-7">{item.title}</h2>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {item.tags.map((tag) => <span class="rounded bg-[var(--color-field)] px-2 py-0.5 text-xs muted">{tag}</span>)}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </section>
</BaseLayout>

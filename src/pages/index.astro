---
import { tools } from "../data/tools";
import BaseLayout from "../layouts/BaseLayout.astro";

const latest = tools[0];
---

<BaseLayout title="首页">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <article class="surface reveal overflow-hidden rounded-lg">
      <div class="grid lg:grid-cols-[1.08fr_0.92fr] lg:items-stretch">
        <a href={latest.links[0].href} class="block">
          <img src={latest.screenshot} alt="" loading="eager" class="aspect-[16/9] h-full w-full object-cover lg:aspect-auto" />
        </a>

        <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
          <h1 class="text-4xl font-semibold leading-tight text-white sm:text-5xl">最新</h1>
          <h2 class="mt-5 text-2xl font-semibold leading-8 text-slate-100 sm:text-3xl">{latest.name}</h2>

          <div class="mt-5 flex flex-wrap gap-2">
            <span class="rounded border hairline bg-[#0f1115] px-2.5 py-1 text-xs text-slate-300">{latest.category}</span>
            {latest.tags.map((tag) => <span class="rounded bg-[#0f1115] px-2.5 py-1 text-xs text-slate-400">{tag}</span>)}
          </div>

          <div class="mt-8">
            <a href={latest.links[0].href} class="inline-flex rounded-md bg-slate-100 px-4 py-2.5 text-sm font-medium text-[#0f1115] transition-colors hover:bg-white">
              查看
            </a>
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

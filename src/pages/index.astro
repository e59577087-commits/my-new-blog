---
import { tools } from "../data/tools";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="首页">
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm text-sky-200">happy,for you</p>
        <h1 class="mt-1 text-3xl font-semibold leading-tight text-white sm:text-4xl">首页</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/tools/" class="rounded-md bg-slate-100 px-3 py-2 text-sm font-medium text-[#0f1115] transition-colors hover:bg-white">
          日常
        </a>
        <a href="/about/" class="rounded-md border hairline bg-[#111318] px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:border-sky-300/35 hover:text-white">
          关于
        </a>
      </div>
    </header>

    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        tools.map((tool) => (
          <article class="surface-soft motion-card relative overflow-hidden rounded-lg p-3 sm:p-4">
            <a href={tool.links[0].href} class="absolute inset-0 rounded-lg" aria-label={`打开${tool.name}`}></a>
            <div class="relative flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-xs text-sky-300/80">{tool.category}</p>
                <h2 class="mt-1 truncate text-lg font-semibold leading-7 text-white">{tool.name}</h2>
              </div>
              <span class="grid size-8 shrink-0 place-items-center rounded-md border hairline bg-[#0f1115] font-mono text-xs text-sky-200">
                {tool.name.slice(0, 1)}
              </span>
            </div>

            <div class="relative mt-3 flex flex-wrap gap-1.5">
              {tool.tags.map((tag) => <span class="rounded bg-[#0f1115] px-2 py-0.5 text-xs text-slate-400">{tag}</span>)}
            </div>

            <div class="relative z-10 mt-4 grid grid-cols-3 gap-1.5 border-t hairline pt-3">
              {
                tool.links.map((link) => (
                  <a href={link.href} class="rounded border hairline px-2 py-1.5 text-center text-xs text-slate-300 transition-colors hover:border-sky-300/40 hover:bg-[#0f1115] hover:text-white">
                    {link.label}
                  </a>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
